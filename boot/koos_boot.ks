set config:telnet to true. set config:suppressautopilot to false. global starttime to 0. global logmsgs to true. global bootvolume to"MASTER_DISK". global datavolume to"SLAVE_1_DISK". global h is list("koos_boot"). global bootlexfiles is list("koos_mission_runner_lex","koos_sys_lex","koos_ves_lex","koos_utl_lex","koos_ui_lex"). global bootlibfiles is list(). global lexfiles is bootlexfiles. global libfiles is bootlibfiles. clearscreen. print("Waiting for load..."). wait until ship:unpacked. print("Waiting for connection..."). list processors in i. local d is 1. local c is 0. local f to 0. local j to core:element:parts. for a in i{if j:contains(a:part){if ship:status="PRELAUNCH" and(a:tag:contains("payload")or a:tag:contains("lander")){a:deactivate().}else if a:part:uid=core:part:uid{set a:tag to"MASTER". set a:volume:name to bootvolume. set c to c+1.}else if a:tag:contains("SLAVE")or a:tag=""{set a:tag to"SLAVE_"+d. set a:volume:name to a:tag+"_DISK". print(a:volume:name+" found."). if(d=1){set datavolume to a:volume:name. print(a:volume:name+" set to data volume.").}set d to d+1. set c to c+1.}}set f to f+a:volume:capacity.}if c=1{set datavolume to bootvolume.}if ship:status="PRELAUNCH" or homeconnection:isconnected{for g in h{copypath("0:/boot/"+g+".ks",bootvolume+":/boot/"+g+".ks").}for b in libfiles{copypath("0:/lib/"+b+".ks",bootvolume+":/lib/"+b+".ks").}for b in lexfiles{copypath("0:/lex/"+b+".ks",datavolume+":/lex/"+b+".ks").}print("Files Copied").}for b in libfiles{runpath(bootvolume+":/lib/"+b).}for b in lexfiles{runpath(datavolume+":/lex/"+b).}utl["refresh config files"](). local e to utl["read config"](). if e:haskey("logmsg"){if e:logmsg="false" set logmsgs to false.}global ves1 to ves["new"](ship,e). global mnv is lex(). utl["build MNV lex"](list("core")). ui["run"]().
