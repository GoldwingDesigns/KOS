set config:telnet to true. global starttime to 0. global logmsgs to true. global bootvolume to"MASTER_DISK". global datavolume to"SLAVE_1_DISK". global f is list("koos_boot"). global bootlexfiles is list("koos_mission_runner_lex","koos_sys_lex","koos_ves_lex","koos_utl_lex","koos_ui_lex"). global bootlibfiles is list(). global lexfiles is bootlexfiles. global libfiles is bootlibfiles. clearscreen. print("Waiting for load..."). wait until ship:unpacked. print("Waiting for connection..."). list processors in g. local c is 1. local d is 0. local e to 0. local h to core:element:parts. for a in g{if h:contains(a:part){if a:bootfilename:contains("boot"){set a:tag to"MASTER". set a:volume:name to bootvolume.}else{set a:tag to"SLAVE_"+c. set a:volume:name to a:tag+"_DISK". print(a:volume:name+" found."). if(c=1){set datavolume to a:volume:name. print(a:volume:name+" set to data volume.").}set c to c+1.}set d to d+1.}set e to e+a:volume:capacity.}if d=1{set datavolume to bootvolume.}if ship:status="PRELAUNCH" or homeconnection:isconnected{for i in f{copypath("0:/boot/"+i+".ks","1:/boot/").}for b in libfiles{copypath("0:/lib/"+b+".ks",datavolume+":/lib/"+b+".ks").}for b in lexfiles{copypath("0:/lex/"+b+".ks",datavolume+":/lex/"+b+".ks").}print("Files Copied").}switch to datavolume. for b in libfiles{runpath(datavolume+":/lib/"+b).}for b in lexfiles{runpath(datavolume+":/lex/"+b).}switch to bootvolume. utl["refresh config files"](). global ves1 to ves["new"](ship,utl["read config"]()). global mnv is lex(). utl["build MNV lex"](list("core")). ui["run"]().
