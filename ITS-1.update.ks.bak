{
local UBOOTFILES is LIST("koos_boot.ks").
local ULIBFILES is LIST(
	"koos_loop.ks",
	"koos_init.ks",
	"lib_utils.ks",
	"koos_maneuvers.ks",
	"lib_gui_box.ks",
	"lib_hillclimb.ks",
	"lib_gui_func.ks",
	"lib_lazcalc.ks").
local thisfn to "ITS-1.update.ks".
	
Switch to 1.
List FILES In allFiles.
For file In allFiles { if file:isfile deletepath(file). }
For bfile in UBOOTFILES { copypath("0:/boot/"+bfile,"1:/boot/"). }
For lfile in ULIBFILES { copypath("0:/"+lfile,"1:"). }
movepath("0:/"+thisfn,"0:/"+thisfn+".bak").
reboot.
}
	