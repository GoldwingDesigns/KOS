runoncepath(bb+":/lib/lib_enum"). function get_path_to_apprpoint{parameter l to target. local a to "". local s to ship:bounds:relmax:mag*2. if l:istype("Vessel"){set a to l:bounds.}else if l:istype("Part"){set a to l:ship:bounds.}local aa to l:nodeposition+l:portfacing:vector*(a:relmax:mag+(ship:bounds:relmax:mag*2)). local ab to an(a,s). local ac to ab:copy. ac:add(aa). return ao(ship:position,aa,ab,ap@:bind(aq@:bind(a),ac)).}function ar{parameter a,m to ship:position,f to target:nodeposition+target:portfacing:vector*a:relmax:mag. local t to target:ship:facing:inverse. set m to m*t. set f to f*t. local g is 1.7976931348623157e+308. local o to-g. local p to g. local ad to t*(a:absmin). local ae to t*(a:absmax). if f:x<>0{local af to(ad:x-m:x)/f:x. local ag to(ae:x-m:x)/f:x. set o to max(o,min(af,ag)). set p to min(p,max(af,ag)).}if f:y<>0{local ah to(ad:y-m:y)/f:y. local ai to(ae:y-m:y)/f:y. set o to max(o,min(ah,ai)). set p to min(p,max(ah,ai)).}return p>o.}function an{parameter a,s to ship:bounds:relmax:mag. local d to a:relmin:normalized*(a:relmin:mag+s). local e to a:relmax:normalized*(a:relmax:mag+s). local h to a:absorigin. local b to a:facing. return list(h+b*v(d:x,d:y,d:z),h+b*v(d:x,d:y,e:z),h+b*v(d:x,e:y,d:z),h+b*v(d:x,e:y,e:z),h+b*v(e:x,d:y,d:z),h+b*v(e:x,d:y,e:z),h+b*v(e:x,e:y,d:z),h+b*v(e:x,e:y,e:z)).}function aq{parameter as,j,a. return not ar(as,j,a).}function ap{parameter au,av,c. local aj to list(). for i in av{if i<>c{if au(c,i){aj:add(i).}}}return aj.}function ao{parameter u,w,aw,ax. local g is 1.7976931348623157e+308. local b is lex(). local n is lex(). local ay is lex(). local x is lex(). local k is queue(). function az{parameter j,a. return b[j]-b[a].}function ak{parameter j,a. return abs((j-a):mag).}function al{parameter j. return ak(j,w).}function ba{parameter c. local y to list(). y:add(c). until not x:haskey(c){set c to x[c]. y:insert(0,c).}return y.}for i in aw{b:add(i,g). n:add(i,g). ay:add(i,g). x:add(i,"").}n:add(w,g). b:add(w,g). b:add(u,al(u)). n:add(u,0). k:push(u). local am to 0. until k:length=0{set k to bc["sort"](k,az@). local c to k:pop. if c=w{return ba(c).}for a in ax(c){local z to n[c]+ak(c,a). if z<n[a]{set x[a]to c. set n[a]to z. set b[a]to z+al(a). if not k:contains(a){k:push(a).}}}set am to am+1.}return list().}
