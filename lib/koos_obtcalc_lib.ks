local ab to positionat@. local f to abs@. local d to mod@. local g to cos@. local h to sin@. local function am{parameter a,t. return(ab(ship,t)-ab(a,t)):mag.}local function an{parameter a,t. return(am(a,t+1)-am(a,t-1))/2.}function cpa{parameter a,bd,cg is false,ch is 1. local k is time:seconds. local u is k+ship:orbit:period. if hasnode{set k to time:seconds+bd:eta. set u to k+bd:orbit:period.}local m is(k+u)/2. local ci is an(a,k). local ao is an(a,m). until(u-k<0.1)or f(ao)<0.1^ch{if(ao*ci)>0 set k to m. else set u to m. set m to(k+u)/2. set ao to an(a,m).}if cg{return m.}else{return am(a,m).}}function orbit_circumference{local e is ship:orbit:semimajoraxis. local ap is ship:orbit:semiminoraxis. local be is(e-ap)^2/(e+ap)^2. local cj is constant:pi*(e+ap)*(1+3*be/(10+sqrt(4-3*be))). return cj.}function orbit_period{parameter ck is body,aq is ship:obt:periapsis,e is ship:obt:apoapsis. set aq to aq+body:radius. set e to e+body:radius. return sqrt((4*(constant:pi^2)*((aq+e)/2)^3)/ck:mu).}function etatoaltitude2{parameter cl to 1000000. local bf is((ab(ship,time:seconds+eta:periapsis)-body:position):mag-body:radius). local ac is eta:periapsis. until bf>=cl{set ac to ac-1. set bf to((ab(ship,time:seconds+ac)-body:position):mag-body:radius).}return ac.}function pitchangle{local parameter cm. local cn to up:forevector. local bg to cm:forevector. local co to arccos((vdot(bg,cn)/(bg:mag))). return co.}function findlaunchwindowtotarget{parameter ar is 60,bh is target. return findlaunchwindow(ar,bh:orbit:inclination,bh:orbit:lan).}function findlaunchwindow{parameter ar is 60,c is 0,w is 0. local bi is ar/3600. local x is 0. local j is 6. local ad is 360/(j). local ae is latitude. local cp is longitude. local y to(d(body:rotationangle+d((360+cp),360),360))/ad. if f(c)<f(ae){ui["msg add"]("Unable to match target inclination"). return list(-1,-1).}else if c=f(ae){local cq is(w+90)/ad. set x to time:seconds+(d(cq-y+j,j)*3600). return list(x,c).}else{local cr is arcsin(g(c)/g(ae)). local af is arccos(g(cr)/h(c)). local as is 0. local au is 0. local z is 0. if ae<0 set z to z+1. if c>90 or c<-90 set z to z+1. if z=0{set as to w-af. set au to w+(180+af).}else{set as to w+af. set au to w+(180-af).}local bj is as/ad. local bk is au/ad. local e is c. local i is 0. if y+bi>bj and y+bi<bk{set e to-1*e. set i to bk-y. until i>0 set i to i+j. set x to time:seconds+(d(i+j,j)*3600).}else{set i to bj-y. until i>0 set i to i+j. set x to time:seconds+(d(i+j,j)*3600).}return list(x,e).}}function plane_change_info{parameter av,bl. local aw to ship:obt:inclination. local bm to ship:obt:lan. local bn to v(h(aw)*g(bm+90),h(aw)*h(bm+90),g(aw)). local bo to v(h(av)*g(bl+90),h(av)*h(bl+90),g(av)). local bp to vcrs(bo,bn). local cs to arccos(vdot(bo,bn)). local ag to d(arctan2(bp:y,bp:x)+360,360). local bq to 1. local ah to d(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local ct to d((720+ag-ah),360). if ct>180{set bq to-1. set ag to d(ag+180,360).}local cu is cv(ag). local cw is cu+time:seconds. return list(cs,cw,bq).}function getlanforsunangle{parameter cx is 90,cy is 0. local ai is vang((body("sun"):position),(solarprimevector)). local cz is vcrs((body("sun"):position):normalized,(solarprimevector):normalized):y. if cz<0 set ai to 360-ai. local br is(cx+cy)/2. local n is ai-br. local aa is ai+br. set n to d(n+720,360). until aa<360{set aa to aa-360.}local bs is obt:lan. if obt:inclination>0{if f(bs-n)<90 return n. else return aa.}else{if f(bs-n)<90 return aa. else return n.}}function find_landing_tgt_lan{parameter a,l,ax is 20000,da is ship:obt:semimajoraxis-a:body:radius. local db is orbit_period(a:body,da,ax). local bt is orbit_period(a:body,ax,ax). local ay is a:body:rotationperiod. local bu to true. if vdot(a:position-body:position,ship:position-body:position)<0 set bu to false. local b to 0. set b to dc(a,l)+a:body:rotationangle+(((db/ay)*360)*0.5)+(((bt/ay)*360)*0.25). if bu=false set b to b+(((bt/ay)*360)*0.5). until b>=0{set b to b+360.}until b<=360{set b to b-360.}local dd to plane_change_info(l,b). local de to dd[1]. set b to b+body:angularvel:mag*constant:radtodeg*(de-time:seconds). until b>=0{set b to b+360.}until b<=360{set b to b-360.}return b.}function cv{declare local parameter az. local ah to d(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local bv to(mod(720+az-(obt:lan+obt:argumentofperiapsis),360)). local bw to ship:obt:inclination<91. local aj to 0. local ak to obt:eccentricity. if ak<0.001{if bw{set aj to ship:obt:period*((d(az-ah+720,360)))/360.}else{set aj to ship:obt:period*((d(360-az-ah+720,360)))/360.}}else{local bx to	arccos((ak+g(bv))/(1+ak*g(bv))). local by to(bx-((180/(constant():pi))*(ak*h(bx)))). local ba to 0. if bw{set ba to ship:obt:period*by/360.}else{set ba to ship:obt:period*(360-by)/360.}local df to((obt:meananomalyatepoch)*obt:period/360). set aj to d(obt:period+ba-df,obt:period).}return aj.}function circle_distance{parameter bb,bc,dg. local e is h((bb:lat-bc:lat)/2)^2+g(bb:lat)*g(bc:lat)*h((bb:lng-bc:lng)/2)^2. return dg*constant():pi*arctan2(sqrt(e),sqrt(1-e))/90.}function dc{parameter a,l. local o is a:lat. local al is a:lng. local c is 0. if l<90{if f(l-f(o))<0.001{set c to 90.}else{set c to f(arcsin(tan(o)/tan(l))).}if o>0{return al-c.}else{return al-c+180.}}else{if f((180-l)-f(o))<0.001{set c to 90.}else{set c to f(arcsin(tan(o)/tan(180-l))).}if o<0{return al-c.}else{return al-c+180.}}}function calc_ejection_utc{parameter dh,bz to time:seconds. local ca is max(bz-time:seconds,0). local cb is 360/body:orbit:period. local cc is 360/ship:orbit:period. local ce to(ship:orbit:position-body:position):normalized. local cf to(-1*body:body:velocity:orbit):normalized. local p to vang(cf,ce). local di to vcrs(cf,ce). if vdot(v(1,1,1),di)<=0{set p to-1*p.}if p<0 set p to p+360. local s is p-dh. set s to s+(cb*ca-cc*ca). until s<360{set s to s-360.}local dj to bz+(s)/f(cb-cc). return dj.}
