local x to positionat@. local g to abs@. local e to mod@. local f to cos@. local h to sin@. function ah{parameter a,o. return(x(ship,o)-x(a,o)):mag.}function ai{parameter a,o. return(ah(a,o+1)-ah(a,o-1))/2.}function ct{parameter a,ay,bt is false,bu is 1. local k is time:seconds. local p is k+ship:orbit:period. if hasnode{set k to time:seconds+ay:eta. set p to k+ay:orbit:period.}local m is(k+p)/2. local bv is ai(a,k). local aj is ai(a,m). until(p-k<0.1)or g(aj)<0.1^bu{if(aj*bv)>0 set k to m. else set p to m. set m to(k+p)/2. set aj to ai(a,m).}if bt{return m.}else{return ah(a,m).}}function orbit_circumference{local d is ship:orbit:semimajoraxis. local ak is ship:orbit:semiminoraxis. local az is(d-ak)^2/(d+ak)^2. local bw is constant:pi*(d+ak)*(1+3*az/(10+sqrt(4-3*az))). return bw.}function ba{parameter bx is body,al is ship:obt:periapsis,d is ship:obt:apoapsis. set al to al+body:radius. set d to d+body:radius. return sqrt((4*(constant:pi^2)*((al+d)/2)^3)/bx:mu).}function etatoaltitude2{parameter by to 1000000. local bb is((x(ship,time:seconds+eta:periapsis)-body:position):mag-body:radius). local y is eta:periapsis. until bb>=by{set y to y-1. set bb to((x(ship,time:seconds+y)-body:position):mag-body:radius).}return y.}function pitchangle{local parameter bz. local ca to up:forevector. local bc to bz:forevector. local cb to arccos((vdot(bc,ca)/(bc:mag))). return cb.}function cu{parameter am is 60,bd is target. return cc(am,bd:orbit:inclination,bd:orbit:lan).}function cc{parameter am is 60,c is 0,s is 0. local be is am/3600. local t is 0. local j is 6. local z is 360/(j). local aa is latitude. local ce is longitude. local u to(e(body:rotationangle+e((360+ce),360),360))/z. if g(c)<g(aa){ui["msg add"]("Unable to match target inclination"). return list(-1,-1).}else if c=g(aa){local cf is(s+90)/z. set t to time:seconds+(e(cf-u+j,j)*3600). return list(t,c).}else{local cg is arcsin(f(c)/f(aa)). local ab is arccos(f(cg)/h(c)). local an is 0. local ao is 0. local w is 0. if aa<0 set w to w+1. if c>90 or c<-90 set w to w+1. if w=0{set an to s-ab. set ao to s+(180+ab).}else{set an to s+ab. set ao to s+(180-ab).}local bf is an/z. local bg is ao/z. local d is c. local i is 0. if u+be>bf and u+be<bg{set d to-1*d. set i to bg-u. until i>0 set i to i+j. set t to time:seconds+(e(i+j,j)*3600).}else{set i to bf-u. until i>0 set i to i+j. set t to time:seconds+(e(i+j,j)*3600).}return list(t,d).}}function plane_change_info{parameter ap,bh. local aq to ship:obt:inclination. local bi to ship:obt:lan. local bj to v(h(aq)*f(bi+90),h(aq)*h(bi+90),f(aq)). local bk to v(h(ap)*f(bh+90),h(ap)*h(bh+90),f(ap)). local bl to vcrs(bk,bj). local ch to arccos(vdot(bk,bj)). local ac to e(arctan2(bl:y,bl:x)+360,360). local bm to 1. local ad to e(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local ci to e((720+ac-ad),360). if ci>180{set bm to-1. set ac to e(ac+180,360).}local cj is ck(ac). local cl is cj+time:seconds. return list(ch,cl,bm).}function find_landing_tgt_lan{parameter a,l,ar is 20000,cm is ship:obt:semimajoraxis-a:body:radius. local cn is ba(a:body,cm,ar). local bn is ba(a:body,ar,ar). local as is a:body:rotationperiod. local bo to true. if vdot(a:position-body:position,ship:position-body:position)<0 set bo to false. local b to 0. set b to co(a,l)+a:body:rotationangle+(((cn/as)*360)*0.5)+(((bn/as)*360)*0.25). if bo=false set b to b+(((bn/as)*360)*0.5). until b>=0{set b to b+360.}until b<=360{set b to b-360.}local cp to plane_change_info(l,b). local cq to cp[1]. set b to b+body:angularvel:mag*constant:radtodeg*(cq-time:seconds). until b>=0{set b to b+360.}until b<=360{set b to b-360.}return b.}function ck{declare local parameter au. local ad to e(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local bp to(mod(720+au-(obt:lan+obt:argumentofperiapsis),360)). local bq to ship:obt:inclination<91. local ae to 0. local af to obt:eccentricity. if af<0.001{if bq{set ae to ship:obt:period*((e(au-ad+720,360)))/360.}else{set ae to ship:obt:period*((e(360-au-ad+720,360)))/360.}}else{local br to	arccos((af+f(bp))/(1+af*f(bp))). local bs to(br-((180/(constant():pi))*(af*h(br)))). local av to 0. if bq{set av to ship:obt:period*bs/360.}else{set av to ship:obt:period*(360-bs)/360.}local cr to((obt:meananomalyatepoch)*obt:period/360). set ae to e(obt:period+av-cr,obt:period).}return ae.}function circle_distance{parameter aw,ax,cs. local d is h((aw:lat-ax:lat)/2)^2+f(aw:lat)*f(ax:lat)*h((aw:lng-ax:lng)/2)^2. return cs*constant():pi*arctan2(sqrt(d),sqrt(1-d))/90.}function co{parameter a,l. local n is a:lat. local ag is a:lng. local c is 0. if l<90{if g(l-g(n))<0.001{set c to 90.}else{set c to g(arcsin(tan(n)/tan(l))).}if n>0{return ag-c.}else{return ag-c+180.}}else{if g((180-l)-g(n))<0.001{set c to 90.}else{set c to g(arcsin(tan(n)/tan(180-l))).}if n<0{return ag-c.}else{return ag-c+180.}}}
