local z to positionat@. local f to abs@. local d to mod@. local g to cos@. local h to sin@. local function ak{parameter a,p. return(z(ship,p)-z(a,p)):mag.}local function al{parameter a,p. return(ak(a,p+1)-ak(a,p-1))/2.}function cpa{parameter a,bb,bx is false,by is 1. local k is time:seconds. local s is k+ship:orbit:period. if hasnode{set k to time:seconds+bb:eta. set s to k+bb:orbit:period.}local m is(k+s)/2. local bz is al(a,k). local am is al(a,m). until(s-k<0.1)or f(am)<0.1^by{if(am*bz)>0 set k to m. else set s to m. set m to(k+s)/2. set am to al(a,m).}if bx{return m.}else{return ak(a,m).}}function orbit_circumference{local e is ship:orbit:semimajoraxis. local an is ship:orbit:semiminoraxis. local bc is(e-an)^2/(e+an)^2. local ca is constant:pi*(e+an)*(1+3*bc/(10+sqrt(4-3*bc))). return ca.}function orbit_period{parameter cb is body,ao is ship:obt:periapsis,e is ship:obt:apoapsis. set ao to ao+body:radius. set e to e+body:radius. return sqrt((4*(constant:pi^2)*((ao+e)/2)^3)/cb:mu).}function etatoaltitude2{parameter cc to 1000000. local bd is((z(ship,time:seconds+eta:periapsis)-body:position):mag-body:radius). local aa is eta:periapsis. until bd>=cc{set aa to aa-1. set bd to((z(ship,time:seconds+aa)-body:position):mag-body:radius).}return aa.}function pitchangle{local parameter ce. local cf to up:forevector. local be to ce:forevector. local cg to arccos((vdot(be,cf)/(be:mag))). return cg.}function findlaunchwindowtotarget{parameter ap is 60,bf is target. return ch(ap,bf:orbit:inclination,bf:orbit:lan).}function ch{parameter ap is 60,c is 0,t is 0. local bg is ap/3600. local u is 0. local j is 6. local ab is 360/(j). local ac is latitude. local ci is longitude. local w to(d(body:rotationangle+d((360+ci),360),360))/ab. if f(c)<f(ac){ui["msg add"]("Unable to match target inclination"). return list(-1,-1).}else if c=f(ac){local cj is(t+90)/ab. set u to time:seconds+(d(cj-w+j,j)*3600). return list(u,c).}else{local ck is arcsin(g(c)/g(ac)). local ad is arccos(g(ck)/h(c)). local aq is 0. local ar is 0. local x is 0. if ac<0 set x to x+1. if c>90 or c<-90 set x to x+1. if x=0{set aq to t-ad. set ar to t+(180+ad).}else{set aq to t+ad. set ar to t+(180-ad).}local bh is aq/ab. local bi is ar/ab. local e is c. local i is 0. if w+bg>bh and w+bg<bi{set e to-1*e. set i to bi-w. until i>0 set i to i+j. set u to time:seconds+(d(i+j,j)*3600).}else{set i to bh-w. until i>0 set i to i+j. set u to time:seconds+(d(i+j,j)*3600).}return list(u,e).}}function plane_change_info{parameter as,bj. local au to ship:obt:inclination. local bk to ship:obt:lan. local bl to v(h(au)*g(bk+90),h(au)*h(bk+90),g(au)). local bm to v(h(as)*g(bj+90),h(as)*h(bj+90),g(as)). local bn to vcrs(bm,bl). local cl to arccos(vdot(bm,bl)). local ae to d(arctan2(bn:y,bn:x)+360,360). local bo to 1. local af to d(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local cm to d((720+ae-af),360). if cm>180{set bo to-1. set ae to d(ae+180,360).}local cn is co(ae). local cp is cn+time:seconds. return list(cl,cp,bo).}function getlanforsunangle{parameter cq is 90,cr is 0. local ag is vang((body("sun"):position),(solarprimevector)). local cs is vcrs((body("sun"):position):normalized,(solarprimevector):normalized):y. if cs<0 set ag to 360-ag. local bp is(cq+cr)/2. local n is ag-bp. local y is ag+bp. set n to d(n+720,360). until y<360{set y to y-360.}local bq is obt:lan. if obt:inclination>0{if f(bq-n)<90 return n. else return y.}else{if f(bq-n)<90 return y. else return n.}}function find_landing_tgt_lan{parameter a,l,av is 20000,ct is ship:obt:semimajoraxis-a:body:radius. local cu is orbit_period(a:body,ct,av). local br is orbit_period(a:body,av,av). local aw is a:body:rotationperiod. local bs to true. if vdot(a:position-body:position,ship:position-body:position)<0 set bs to false. local b to 0. set b to cv(a,l)+a:body:rotationangle+(((cu/aw)*360)*0.5)+(((br/aw)*360)*0.25). if bs=false set b to b+(((br/aw)*360)*0.5). until b>=0{set b to b+360.}until b<=360{set b to b-360.}local cw to plane_change_info(l,b). local cx to cw[1]. set b to b+body:angularvel:mag*constant:radtodeg*(cx-time:seconds). until b>=0{set b to b+360.}until b<=360{set b to b-360.}return b.}function co{declare local parameter ax. local af to d(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local bt to(mod(720+ax-(obt:lan+obt:argumentofperiapsis),360)). local bu to ship:obt:inclination<91. local ah to 0. local ai to obt:eccentricity. if ai<0.001{if bu{set ah to ship:obt:period*((d(ax-af+720,360)))/360.}else{set ah to ship:obt:period*((d(360-ax-af+720,360)))/360.}}else{local bv to	arccos((ai+g(bt))/(1+ai*g(bt))). local bw to(bv-((180/(constant():pi))*(ai*h(bv)))). local ay to 0. if bu{set ay to ship:obt:period*bw/360.}else{set ay to ship:obt:period*(360-bw)/360.}local cy to((obt:meananomalyatepoch)*obt:period/360). set ah to d(obt:period+ay-cy,obt:period).}return ah.}function circle_distance{parameter az,ba,cz. local e is h((az:lat-ba:lat)/2)^2+g(az:lat)*g(ba:lat)*h((az:lng-ba:lng)/2)^2. return cz*constant():pi*arctan2(sqrt(e),sqrt(1-e))/90.}function cv{parameter a,l. local o is a:lat. local aj is a:lng. local c is 0. if l<90{if f(l-f(o))<0.001{set c to 90.}else{set c to f(arcsin(tan(o)/tan(l))).}if o>0{return aj-c.}else{return aj-c+180.}}else{if f((180-l)-f(o))<0.001{set c to 90.}else{set c to f(arcsin(tan(o)/tan(180-l))).}if o<0{return aj-c.}else{return aj-c+180.}}}
