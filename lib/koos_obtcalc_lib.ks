local x to positionat@. local g to abs@. local e to mod@. local f to cos@. local h to sin@. local function ah{parameter a,o. return(x(ship,o)-x(a,o)):mag.}local function ai{parameter a,o. return(ah(a,o+1)-ah(a,o-1))/2.}function cpa{parameter a,ay,bs is false,bt is 1. local k is time:seconds. local p is k+ship:orbit:period. if hasnode{set k to time:seconds+ay:eta. set p to k+ay:orbit:period.}local m is(k+p)/2. local bu is ai(a,k). local aj is ai(a,m). until(p-k<0.1)or g(aj)<0.1^bt{if(aj*bu)>0 set k to m. else set p to m. set m to(k+p)/2. set aj to ai(a,m).}if bs{return m.}else{return ah(a,m).}}function orbit_circumference{local d is ship:orbit:semimajoraxis. local ak is ship:orbit:semiminoraxis. local az is(d-ak)^2/(d+ak)^2. local bv is constant:pi*(d+ak)*(1+3*az/(10+sqrt(4-3*az))). return bv.}function orbit_period{parameter bw is body,al is ship:obt:periapsis,d is ship:obt:apoapsis. set al to al+body:radius. set d to d+body:radius. return sqrt((4*(constant:pi^2)*((al+d)/2)^3)/bw:mu).}function etatoaltitude2{parameter bx to 1000000. local ba is((x(ship,time:seconds+eta:periapsis)-body:position):mag-body:radius). local y is eta:periapsis. until ba>=bx{set y to y-1. set ba to((x(ship,time:seconds+y)-body:position):mag-body:radius).}return y.}function pitchangle{local parameter by. local bz to up:forevector. local bb to by:forevector. local ca to arccos((vdot(bb,bz)/(bb:mag))). return ca.}function cs{parameter am is 60,bc is target. return cb(am,bc:orbit:inclination,bc:orbit:lan).}function cb{parameter am is 60,c is 0,s is 0. local bd is am/3600. local t is 0. local j is 6. local z is 360/(j). local aa is latitude. local cc is longitude. local u to(e(body:rotationangle+e((360+cc),360),360))/z. if g(c)<g(aa){ui["msg add"]("Unable to match target inclination"). return list(-1,-1).}else if c=g(aa){local ce is(s+90)/z. set t to time:seconds+(e(ce-u+j,j)*3600). return list(t,c).}else{local cf is arcsin(f(c)/f(aa)). local ab is arccos(f(cf)/h(c)). local an is 0. local ao is 0. local w is 0. if aa<0 set w to w+1. if c>90 or c<-90 set w to w+1. if w=0{set an to s-ab. set ao to s+(180+ab).}else{set an to s+ab. set ao to s+(180-ab).}local be is an/z. local bf is ao/z. local d is c. local i is 0. if u+bd>be and u+bd<bf{set d to-1*d. set i to bf-u. until i>0 set i to i+j. set t to time:seconds+(e(i+j,j)*3600).}else{set i to be-u. until i>0 set i to i+j. set t to time:seconds+(e(i+j,j)*3600).}return list(t,d).}}function plane_change_info{parameter ap,bg. local aq to ship:obt:inclination. local bh to ship:obt:lan. local bi to v(h(aq)*f(bh+90),h(aq)*h(bh+90),f(aq)). local bj to v(h(ap)*f(bg+90),h(ap)*h(bg+90),f(ap)). local bk to vcrs(bj,bi). local cg to arccos(vdot(bj,bi)). local ac to e(arctan2(bk:y,bk:x)+360,360). local bl to 1. local ad to e(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local ch to e((720+ac-ad),360). if ch>180{set bl to-1. set ac to e(ac+180,360).}local ci is cj(ac). local ck is ci+time:seconds. return list(cg,ck,bl).}function find_landing_tgt_lan{parameter a,l,ar is 20000,cl is ship:obt:semimajoraxis-a:body:radius. local cm is orbit_period(a:body,cl,ar). local bm is orbit_period(a:body,ar,ar). local as is a:body:rotationperiod. local bn to true. if vdot(a:position-body:position,ship:position-body:position)<0 set bn to false. local b to 0. set b to cn(a,l)+a:body:rotationangle+(((cm/as)*360)*0.5)+(((bm/as)*360)*0.25). if bn=false set b to b+(((bm/as)*360)*0.5). until b>=0{set b to b+360.}until b<=360{set b to b-360.}local co to plane_change_info(l,b). local cp to co[1]. set b to b+body:angularvel:mag*constant:radtodeg*(cp-time:seconds). until b>=0{set b to b+360.}until b<=360{set b to b-360.}return b.}function cj{declare local parameter au. local ad to e(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360). local bo to(mod(720+au-(obt:lan+obt:argumentofperiapsis),360)). local bp to ship:obt:inclination<91. local ae to 0. local af to obt:eccentricity. if af<0.001{if bp{set ae to ship:obt:period*((e(au-ad+720,360)))/360.}else{set ae to ship:obt:period*((e(360-au-ad+720,360)))/360.}}else{local bq to	arccos((af+f(bo))/(1+af*f(bo))). local br to(bq-((180/(constant():pi))*(af*h(bq)))). local av to 0. if bp{set av to ship:obt:period*br/360.}else{set av to ship:obt:period*(360-br)/360.}local cq to((obt:meananomalyatepoch)*obt:period/360). set ae to e(obt:period+av-cq,obt:period).}return ae.}function circle_distance{parameter aw,ax,cr. local d is h((aw:lat-ax:lat)/2)^2+f(aw:lat)*f(ax:lat)*h((aw:lng-ax:lng)/2)^2. return cr*constant():pi*arctan2(sqrt(d),sqrt(1-d))/90.}function cn{parameter a,l. local n is a:lat. local ag is a:lng. local c is 0. if l<90{if g(l-g(n))<0.001{set c to 90.}else{set c to g(arcsin(tan(n)/tan(l))).}if n>0{return ag-c.}else{return ag-c+180.}}else{if g((180-l)-g(n))<0.001{set c to 90.}else{set c to g(arcsin(tan(n)/tan(180-l))).}if n<0{return ag-c.}else{return ag-c+180.}}}
