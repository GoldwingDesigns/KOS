local y is 2^64. local k is queue(). local h is 0. local s is y. local t is node(0,0,0,0). function hillclimb{parameter b,f,c,i. if u(b,f,c,i)[1]=0 return b. k:clear(). k:push(b). set h to 0. until z(f,c,i){}return t.}local function z{parameter f,c,i. local b is k:pop(). local m to list(). m:clear. from{local a is 0.}until a=8 step{set a to a+1.}do{m:add(u(aa(b,a),f,c,i)).}local n is ab(m). local o is n[0][1]. if o=0{set t to n[0][0]. return true.}if o>s{k:push(b). if h<4{set h to h+1.}else{set h to 0.}}else{k:push(n[0][0]). set s to o.}return false.}local function af{parameter w. local p is 0. for g in w{set p to p+g[1].}local ac is p/w:length. return ac.}local function ab{parameter g. local ad to g:length. from{local a is 1.}until a>=ad step{set a to a+1.}do{set x to g[a]. set d to a-1. until d<0 or g[d][1]<=x[1]{set g[d+1]to g[d]. set d to d-1.}set g[d+1]to x.}return g.}local function u{parameter b,f,c,i. add b. wait 0.1. local e is ae(f,c,b). remove b. if e<i{return list(b,0).}return list(b,e).}local function ae{parameter f,c,b. local e is 1. from{local a is 0.}until a=c:length step{set a to a+2.}do{if c[a]="periapsis"{if b:orbit:hasnextpatch set e to e+abs(b:orbit:nextpatch:periapsis-c[a+1]). else set e to e+abs(cpa(f,b)-c[a+1]).}if c[a]="inclination"{set e to e+(abs(b:orbit:nextpatch:inclination-c[a+1])*100).}if c[a]="eccentricity"{set e to e+abs(b:orbit:nextpatch:eccentricity-c[a+1]).}if c[a]="shiptoship"{set e to e+abs(cpa(f,b)-c[a+1]).}}return e.}local function aa{parameter b,a. local d is 1/10^h. local j is 10. set l to list(list(d*j,0,0,0),list(-d*j,0,0,0),list(0,0,0,d),list(0,0,0,-d),list(0,0,d*j,0),list(0,0,-d*j,0),list(0,d*j,0,0),list(0,-d*j,0,0)). return node(time:seconds+b:eta+l[a][0],b:radialout+l[a][1],b:normal+l[a][2],b:prograde+l[a][3]).}
