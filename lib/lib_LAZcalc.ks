function lazcalc_init{parameter e,b. local c is latitude. local a is list(). if e<=0{print"Target altitude cannot be below sea level". set l to 1/0.}. local f to"Ascending". if b<0{set f to"Descending". set b to abs(b).}. if abs(c)>b{set b to abs(c).}. if 180-abs(c)<b{set b to 180-abs(c).}. local h is(2*constant():pi*body:radius)/body:rotationperiod. local i is sqrt(body:mu/(body:radius+e)). a:add(b). a:add(c). a:add(h). a:add(i). a:add(f). return a.}function lazcalc{parameter a. local g is arcsin(max(min(cos(a[0])/cos(latitude),1),-1)). local j is a[3]*sin(g)-a[2]*cos(a[1]). local k is a[3]*cos(g). local d is mod(arctan2(j,k)+360,360). if a[4]="Ascending"{return d.}else if a[4]="Descending"{if d<=90{return 180-d.}else if d>=270{return 540-d.}.}.}
