{global sys is lexicon("wait soi chng",e@,"warp next patch",f@,"wait time",g@,"warp to alt",h@,"warp to time",i@,"pause",j@). function e{parameter c. return list({if body:name=c{ui["msg add"]("SOI Change To "+c). return true.}else{return false.}}).}function i{parameter d. return list({warpto(d). return true.},{return time:seconds>=d.}).}function j{kuniverse:pause(). return true.}function f{warpto(time:seconds+orbit:nextpatcheta-5). return true.}function h{parameter a,b to true. return list({if(b and altitude>a)or(not b and altitude<a){warpto(etatoaltitude2(a)+time:seconds).}return true.},{if b return altitude<a. else return altitude>a.}).}function g{parameter a. local k to time:seconds+a. return list({if time:seconds>k{return true.}else{return false.}}).}}
