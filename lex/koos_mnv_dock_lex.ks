local d to vdot@.{global mnv_tmp is lexicon("align ports facing",af@,"cancel vel RCS",ag@,"cancel vel",bj@,"distant approach",bk@,"get own port",y@,"get best tgt port",as@,"close approach",ah@,"final approach",au@,"dock with vessel",bl@,"undock from vessel",bm@). function ai{parameter u,l to ship,e to 1,m to e/100,n is false. rcs on. local bn to u-(l:position). local o is ves1["&RCSgain"](). local av to o*2. local bo to o*0.2. local aj to av^2. local ak to 0. local al to 2*bo*av. local h to v(0,0,0). local am to-1. local an to 1. if not n{lock h to(bn+(l:position))-ship:controlpart:position.}else{lock h to l:nodeposition-ship:controlpart:position.}. lock w to h:mag. lock p to facing:starvector. lock s to facing:topvector. lock x to facing:forevector. lock f to h:normalized*max(0.1,min(w/10,e)). if not n{lock i to d(f,p). lock j to d(f,s).}else{lock i to 0. lock j to 0.}lock t to d(f,x). if l:istype("Vessel"){lock z to velocity:orbit-l:velocity:orbit.}else{lock z to velocity:orbit-l:ship:velocity:orbit.}if not n{lock aw to d(z,p). lock ax to d(z,s).}else{lock aw to d(h,-p). lock ax to d(h,-s).}lock bp to d(z,x). local aa to pidloop(aj,ak,al,am,an,m). set aa:setpoint to i. local ab to pidloop(aj,ak,al,am,an,m). set ab:setpoint to j. local ac to pidloop(aj,ak,al,am,an,m). set ac:setpoint to t. local ay to 0. local az to 0. local ba to 0. until w<0.05{if n and ship:controlpart:istype("DockingPort")and ship:controlpart:state<>"Ready"{break.}set ay to aa:update(time:seconds,aw). set ship:control:starboard to ay. if not n{set aa:setpoint to i.}set aa:epsilon to min(m,i/10). set az to ab:update(time:seconds,ax). set ship:control:top to az. if not n{set ab:setpoint to j.}set ab:epsilon to min(m,j/10). set ba to ac:update(time:seconds,bp). set ship:control:fore to ba. set ac:setpoint to t. set ac:epsilon to min(m,t/10).}set ship:control:starboard to 0. set ship:control:fore to 0. set ship:control:top to 0. unlock h. rcs off. return true.}function af{parameter bq. lock steering to-bq:portfacing:vector. ui["msg add"]("Aligning Reference and Target Ports"). wait 5. return true.}function y{if ship:dockingports:length>0{ui["msg add"]("Reference Port Set To "+ship:dockingports[0]:name). return ship:dockingports[0].}}function as{parameter b,k is 0. if b:istype("vessel"){if k=0{set k to y().}if b:dockingports:length<>0{for ad in b:dockingports{if k:nodetype=ad:nodetype and ad:state="Ready"{ui["msg add"]("Target Port Set To "+ad:name). return ad.}}}}else{ui["msg add"]("Target Port Not Found"). return 0.}}function ag{parameter b. if not b:istype("Vessel"){set b to b:ship.}local o is ves1["&RCSgain"](). lock g to velocity:orbit-b:velocity:orbit. lock w to g:mag. lock p to facing:starvector. lock s to facing:topvector. lock x to facing:forevector. lock f to-g:normalized. lock i to d(f,p). lock j to d(f,s). lock t to d(f,x). rcs on. until w<0.01{set ship:control:starboard to o*i. set ship:control:fore to o*t. set ship:control:top to o*j.}set ship:control:starboard to 0. set ship:control:fore to 0. set ship:control:top to 0. unlock w. unlock p. unlock s. unlock x. unlock f. unlock i. unlock j. unlock t. rcs off. wait 1. return true.}function bj{parameter b. if not b:istype("Vessel"){set b to b:ship.}lock g to velocity:orbit-b:velocity:orbit. sas off. lock steering to-g. wait until vcrs(facing:forevector,g):mag<0.1. local ao to 0. lock throttle to ao. until g:mag<0.1{set ao to min(1,g:mag/20).}set ao to 0. unlock g. unlock steering. unlock throttle. sas on. wait 1. return true.}function bk{parameter b to target,e to 1. ui["msg add"]("Distant Approach To "+b:name). ai(b:position:normalized*(b:position:mag-50),b,e). ag(b). return true.}function ah{parameter u,b to target,e to 0.5. ui["msg add"]("Close Approach to "+b:name). ai(u,b,e). ag(b). return true.}function au{parameter u,b to target,e to 0.2. ui["msg add"]("Final Approach To "+b:name). ai(u,b,e,0,true). if ship:controlpart:istype("DockingPort")and ship:controlpart:state<>"Ready"{ui["msg add"]("Docking Complete").}return true.}function bm{function bb{parameter bc. for ae in bc:children{if ae:istype("DockingPort")return ae. if bb(ae):istype("DockingPort")return ae. return bc.}}local bd to 0.2. local a is core:part. local c is "". until(not a:hasparent)or a:istype("DockingPort"){set a to a:parent.}if a:istype("DockingPort"){set c to a:partner. wait 0. a:undock.}else{set a to bb(a). if a:istype("DockingPort"){set c to a:partner. wait 0. a:undock.}}set kuniverse:activevessel to core:vessel. wait 0.1. rcs on. local be is y(). be:controlfrom(). af(c). ah(c:facing:vector*c:ship:bounds:relmax:mag*2,c,0.5). rcs off. sas on. wait 1. unlock steering. bf(be). bf(c). ship:rootpart:controlfrom(). return true.}function bg{parameter a. if a:hasmodule("ModuleAnimateGeneric"){if a:getmodule("ModuleAnimateGeneric"):hasevent("open"){a:getmodule("ModuleAnimateGeneric"):doevent("open").}if a:getmodule("ModuleAnimateGeneric"):hasevent("open shield"){a:getmodule("ModuleAnimateGeneric"):doevent("open shield").}if a:getmodule("ModuleAnimateGeneric"):hasevent("deploy"){a:getmodule("ModuleAnimateGeneric"):doevent("deploy").}}return true.}function bf{parameter a. if a:hasmodule("ModuleAnimateGeneric"){if a:getmodule("ModuleAnimateGeneric"):hasevent("close"){a:getmodule("ModuleAnimateGeneric"):doevent("close").}if a:getmodule("ModuleAnimateGeneric"):hasevent("close shield"){a:getmodule("ModuleAnimateGeneric"):doevent("close shield").}if a:getmodule("ModuleAnimateGeneric"):hasevent("retract"){a:getmodule("ModuleAnimateGeneric"):doevent("retract").}}. return true.}function bl{parameter bh,bs to 2,br to 1,bd to 0.2. sas off. local bi to vessel(bh). set target to bh. local k to y(). bg(k). k:controlfrom(). local c to as(bi,k). if c=0 return true. bg(c). af(c). local ap is list(). set target to c. set ap to get_path_to_apprpoint(c). if ap:length>0{local aq to v(0,0,0). for ar in ap{if ar<>v(0,0,0){ah(ar-aq,bi,br). set aq to aq+ar.}}au(c:nodeposition,c,bd).}unlock steering. sas on. rcs off. return true.}}
