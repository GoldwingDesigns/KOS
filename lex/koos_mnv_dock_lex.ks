local d to vdot@.{global mnv_tmp is lexicon("align ports facing",aq@,"get own port",ae@,"get best tgt port",bf@,"cancel vel RCS",af@,"cancel vel",bg@,"distant approach",bh@,"close approach",bi@,"final approach",bj@,"dock with vessel",bk@,"undock from vessel",bl@,"prepare port",bm@). function ag{parameter u,l is ship,e is 1,m is e/100,n is false. rcs on. local bn to u-(l:position). local o is ves1["&RCSgain"](). local ar to o*2. local bo to o*1. local ah to ar^2. local ai to 0. local aj to 2*bo*ar. local i to v(0,0,0). local ak to-1.0. local al to 1.0. if not n{lock i to(bn+(l:position))-ship:controlpart:position.}else{lock i to l:nodeposition-ship:controlpart:position.}. lock w to i:mag. lock p to facing:starvector. lock s to facing:topvector. lock x to facing:forevector. lock f to i:normalized*max(0.1,min(w/10,e)). if not n{lock j to d(f,p). lock k to d(f,s).}else{lock j to 0. lock k to 0.}lock t to d(f,x). if l:istype("Vessel"){lock y to velocity:orbit-l:velocity:orbit.}else{lock y to velocity:orbit-l:ship:velocity:orbit.}if not n{lock as to d(y,p). lock au to d(y,s).}else{lock as to d(i,-p). lock au to d(i,-s).}lock bp to d(y,x). local z to pidloop(ah,ai,aj,ak,al,m). set z:setpoint to j. local aa to pidloop(ah,ai,aj,ak,al,m). set aa:setpoint to k. local ab to pidloop(ah,ai,aj,ak,al,m). set ab:setpoint to t. local av to 0. local aw to 0. local ax to 0. until w<0.05{if n and ship:controlpart:istype("DockingPort")and ship:controlpart:state<>"Ready"{break.}set av to z:update(time:seconds,as). set ship:control:starboard to av. if not n{set z:setpoint to j.}set z:epsilon to min(m,j/10). set aw to aa:update(time:seconds,au). set ship:control:top to aw. if not n{set aa:setpoint to k.}set aa:epsilon to min(m,k/10). set ax to ab:update(time:seconds,bp). set ship:control:fore to ax. set ab:setpoint to t. set ab:epsilon to min(m,t/10).}set ship:control:starboard to 0. set ship:control:fore to 0. set ship:control:top to 0. unlock i. rcs off. return true.}function aq{parameter bq is target. lock steering to-bq:portfacing:vector. ui["msg add"]("Aligning Reference and Target Ports"). wait 5. return true.}function ae{if ship:dockingports:length>0{ui["msg add"]("Reference Port Set To "+ship:dockingports[0]:name). return ship:dockingports[0].}}function bf{parameter a is target,g is 0. if a:istype("vessel"){if g=0{set g to ae().}if a:dockingports:length<>0{for ac in a:dockingports{if g:nodetype=ac:nodetype and ac:state="Ready"{ui["msg add"]("Target Port Set To "+ac:name). return ac.}}}}else{ui["msg add"]("Target Port Not Found"). return 0.}}function af{parameter a is target. if not a:istype("Vessel"){set a to a:ship.}local o is ves1["&RCSgain"](). lock h to velocity:orbit-a:velocity:orbit. lock w to h:mag. lock p to facing:starvector. lock s to facing:topvector. lock x to facing:forevector. lock f to-h:normalized. lock j to d(f,p). lock k to d(f,s). lock t to d(f,x). rcs on. until w<0.01{set ship:control:starboard to o*j. set ship:control:fore to o*t. set ship:control:top to o*k.}set ship:control:starboard to 0. set ship:control:fore to 0. set ship:control:top to 0. unlock w. unlock p. unlock s. unlock x. unlock f. unlock j. unlock k. unlock t. rcs off. wait 1. return true.}function bg{parameter a is target. if not a:istype("Vessel"){set a to a:ship.}local am to 0. lock h to velocity:orbit-a:velocity:orbit. sas off. lock steering to-1*h. wait until vcrs(facing:forevector,h):mag<0.1. lock throttle to am. until h:mag<0.1{set am to min(1,h:mag/20).}set am to 0. unlock h. unlock steering. unlock throttle. sas on. wait 1. return true.}function bh{parameter a is target,e is 1. ui["msg add"]("Distant Approach To "+a:name). ag(a:position:normalized*(a:position:mag-50),a,e). af(a). return true.}function ay{parameter u,a is target,e is 0.5. ui["msg add"]("Close Approach to "+a:name). ag(u,a,e). af(a). return true.}function bi{parameter a is target,e is 0.5. local az to get_path_to_apprpoint(a). if az:length>0{local an to v(0,0,0). for ao in az{if ao<>v(0,0,0){ay(ao-an,a,e). set an to an+ao.}}}return true.}function bj{parameter u is target:nodeposition,a is target,e is 0.2. ui["msg add"]("Final Approach To "+a:name). ag(u,a,e,0,true). if ship:controlpart:istype("DockingPort")and ship:controlpart:state<>"Ready"{ui["msg add"]("Docking Complete").}return true.}function ba{parameter b. if b:hasmodule("ModuleAnimateGeneric"){if b:getmodule("ModuleAnimateGeneric"):hasevent("close"){b:getmodule("ModuleAnimateGeneric"):doevent("close").}if b:getmodule("ModuleAnimateGeneric"):hasevent("close shield"){b:getmodule("ModuleAnimateGeneric"):doevent("close shield").}if b:getmodule("ModuleAnimateGeneric"):hasevent("retract"){b:getmodule("ModuleAnimateGeneric"):doevent("retract").}}. return true.}function bk{parameter ap is target. local br is 2. local bs is 1. local bb is 0.2. set target to ap. local g to "". local c to "". return list(ves1["RCS ON"]@,{if ap:position:mag>100{mnv["distant approach"](target,br). return true.}else return true.},{set g to mnv["get own port"](). set c to mnv["get best tgt port"](ap,g). mnv["Prepare Port"](g). mnv["Prepare Port"](c). g:controlfrom(). ui["msg add"](c:name). set target to c. return true.},ves1["SAS OFF"]@,mnv["align ports facing"]@,mnv["close approach"]@,mnv["final approach"]@,{unlock steering.},ves1["SAS ON"]@,ves1["RCS OFF"]@).}function bl{function bc{parameter bd. for ad in bd:children{if ad:istype("DockingPort")return ad. if bc(ad):istype("DockingPort")return ad. return bd.}}local bb to 0.2. local b is core:part. local c is "". until(not b:hasparent)or b:istype("DockingPort"){set b to b:parent.}if b:istype("DockingPort"){set c to b:partner. wait 0. b:undock.}else{set b to bc(b). if b:istype("DockingPort"){set c to b:partner. wait 0. b:undock.}}set kuniverse:activevessel to core:vessel. wait 0.1. rcs on. local be is ae(). be:controlfrom(). aq(c). ay(c:facing:vector*c:ship:bounds:relmax:mag*2,c,bb). rcs off. sas on. wait 1. unlock steering. ba(be). ba(c). ship:rootpart:controlfrom(). return true.}function bm{parameter b. if b:hasmodule("ModuleAnimateGeneric"){if b:getmodule("ModuleAnimateGeneric"):hasevent("open"){b:getmodule("ModuleAnimateGeneric"):doevent("open").}if b:getmodule("ModuleAnimateGeneric"):hasevent("open shield"){b:getmodule("ModuleAnimateGeneric"):doevent("open shield").}if b:getmodule("ModuleAnimateGeneric"):hasevent("deploy"){b:getmodule("ModuleAnimateGeneric"):doevent("deploy").}}return true.}}
