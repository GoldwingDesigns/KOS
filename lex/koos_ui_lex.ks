local f to terminal:height. local ah to terminal:width. local ar to ah/2. local z to "". local c to list().{global ui is lexicon("run",as@,"msg add",au@,"AG6 stop",av@). function as{parameter aw to false. if aw{local d to aa(). local ai to ax(). local w to ai[0]. local h to ai[1]. until false{if ag7{ag7 off. if d:length>0{runpath(bootvolume+":/missions/"+d[0]).}}if ag8{ag8 off. if d:length>1{runpath(bootvolume+":/missions/"+d[1]).}}if ag9{ag9 off. if d:length>2{runpath(bootvolume+":/missions/"+d[2]).}}}}else{until false{local a to "". local l to list("Missions","Maneuvers","Vessel","Reboot"). clearscreen. set a to ab("Choose a function:",l). if l[a]="Missions"{ay().}else if l[a]="Maneuvers"{aj(mnv).}else if l[a]="Vessel"{aj(ves1).}else if l[a]="Reboot"{reboot.}}}}function ax{local az to list("Run","Show Status","Stop","Reboot"). local w to lexicon(). local h to lexicon(). local ak to-1. local al to-1. local am to-1. local ba to-1. local ac to 0. local b to 0. local ad to aa(). for v in az{w:add(ac,v). set ac to ac+1.}set ak to b. for m in ad{h:add(b,m). set b to b+1.}set al to b. for m in mnv:keys{h:add(b,m). set b to b+1.}set am to b. for m in ves1:keys{h:add(b,m). set b to b+1.}utl["write commands"](w,h,ak,al,am,ba). return list(w,h).}function aa{if homeconnection:isconnected utl["refresh mission files"](). local ad to utl["list file contains"]("mission",bootvolume,"missions"). return ad.}function ay{until false{local ae is"None". clearscreen. local d is aa(). local af is list(). for bb in d{local an to bb:split("mission_"). af:add(an[an:length-1]:split(".ks")[0]:replace("_"," "):toupper).}af:add("Prev Menu"). set ae to ab("Select a "+core:element:name+" mission file:",af). clearscreen. if ae=-1{return false.}else{runpath(bootvolume+":/missions/"+d[ae]).}}}function aj{parameter ag. until false{local n to ag:keys. n:add("Prev Menu"). local a to "". set a to ab("Select an operation:",n). clearscreen. if a=-1{return false.}else{if n[a]:contains("&"){print"OUTPUT: "+ag[n[a]]()at(2,f-2). wait 2. return false.}else ag[n[a]]().}}}function av{if ag6{ag6 off. bk["stop"]().}}function au{parameter bc. local ao is bd()+" "+bc. print(ao). if logmsgs{utl["write log"](ao).}}function bd{local o is time+missiontime-time:seconds. return"T+"+p(o:year-1)+"-"+p(o:day-1,3)+" "+p(o:hour)+":"+p(o:minute)+":"+p(round(o:second)).}function p{parameter be,bf is 2. return be:tostring:padleft(bf):replace(" ","0").}function ab{parameter bg,s. local g to 0. local t to "". if s:empty{print"error: list_of_names should not be empty". print 1/0.}set z to bg. local ap is s:length(). local x is f/3. until false{if ap>x{set c to s:sublist(g*x,x). if g<>0{c:insert(0,"PREV PAGE").}if(g+1)*x<ap{c:add("NEXT PAGE").}}else{set c to s.}local bh to c:length(). clearscreen. bi(). local a is aq(). until a<bh{print"ERROR: INPUT OUT OF RANGE" at(9,f-3). wait 1. set a to aq().}set t to c[a]. if t="PREV PAGE"{set g to g-1.}else if t="NEXT PAGE"{set g to g+1.}else{break.}}set z to "". set c to list(). if t="PREV MENU"{return-1.}return s:indexof(t).}function bi{local bj is c:length(). print z:padright(ar-3)at(2,2). local i is 0. until i=bj{print i+") "+c[i]at(2,i+4). set i to i+1.}}function aq{local j to queue(). local y is 0. local e to "". local u to "". print"INPUT: " at(2,f-3). until false{if terminal:input:haschar(){local k to terminal:input:getchar(). if k=terminal:input:backspace{if j:length>0{set y to 0. set e to "". until y=j:length-1{set u to j:pop. set e to e+u. j:push(u). set y to y+1.}j:pop. print e+" " at(9,f-3).}}else if k=terminal:input:return{if e="" print "fail" at(9,f-3). else break.}else if unchar(k)>=48 and unchar(k)<=57{j:push(k). set e to e+k. print e at(9,f-3).}}wait 0.1.}set u to "". print u:padright(ah-9)at(9,f-3). return e:toscalar.}}
