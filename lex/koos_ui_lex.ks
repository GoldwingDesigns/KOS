local k to terminal:height. local ag to terminal:width. local as to ag/2. local z to "". local c to list().{global ui is lexicon("run",au@,"msg add",av@,"AG6 stop",aw@). function au{parameter ax to false. if ax{local d to aa(). local ah to ay(). local u to ah[0]. local g to ah[1]. until false{if ag7{ag7 off. if d:length>0{runpath(w+":/missions/"+d[0]).}}if ag8{ag8 off. if d:length>1{runpath(w+":/missions/"+d[1]).}}if ag9{ag9 off. if d:length>2{runpath(w+":/missions/"+d[2]).}}}}else{until false{local a to "". local l to list("Missions","Maneuvers","Vessel","Reboot"). clearscreen. set a to ab("Choose a function:",l). if l[a]="Missions"{az().}else if l[a]="Maneuvers"{ai(mnv).}else if l[a]="Vessel"{ai(ves1).}else if l[a]="Reboot"{reboot.}}}}function ay{local ba to list("Run","Show Status","Stop","Reboot"). local u to lexicon(). local g to lexicon(). local aj to-1. local ak to-1. local al to-1. local bb to-1. local ac to 0. local b to 0. local ad to aa(). for v in ba{u:add(ac,v). set ac to ac+1.}set aj to b. for m in ad{g:add(b,m). set b to b+1.}set ak to b. for m in mnv:keys{g:add(b,m). set b to b+1.}set al to b. for m in ves1:keys{g:add(b,m). set b to b+1.}utl["write commands"](u,g,aj,ak,al,bb). return list(u,g).}function aa{if homeconnection:isconnected utl["refresh mission files"](). local ad to utl["list file contains"]("mission",w,"missions"). return ad.}function az{until false{local ae is"None". clearscreen. local d is aa(). local af is list(). for bc in d{local am to bc:split("mission_"). af:add(am[am:length-1]:split(".ks")[0]:replace("_"," "):toupper).}af:add("Prev Menu"). set ae to ab("Select a "+core:element:name+" mission file:",af). clearscreen. if ae=-1{return false.}else{runpath(w+":/missions/"+d[ae]).}}}function ai{parameter an. until false{local ao to an:keys. ao:add("Prev Menu"). local a to "". set a to ab("Select an operation:",ao). clearscreen. if a="Prev Menu"{return false.}else{an[a]().}}}function aw{if ag6{ag6 off. bj["stop"]().}}function av{parameter bd. local ap is be()+" "+bd. print(ap). if bk{utl["write log"](ap).}}function be{local n is time+missiontime-time:seconds. return"T+"+o(n:year-1)+"-"+o(n:day-1,3)+" "+o(n:hour)+":"+o(n:minute)+":"+o(round(n:second)).}function o{parameter bl,bm is 2. return(""+t):PADLEFT(l):REPLACE("","0").}function ab{parameter bf,p. local f to 0. local s to "". if p:empty{print"error: list_of_names should not be empty". print 1/0.}set z to bf. local aq is p:length(). local x is k/3. until false{if aq>x{set c to p:sublist(f*x,x). if f<>0{c:insert(0,"PREV PAGE").}if(f+1)*x<aq{c:add("NEXT PAGE").}}else{set c to p.}local bg to c:length(). clearscreen. bh(). local a is ar(). until a<bg{print"ERROR: INPUT OUT OF RANGE" at(4,k-3). wait 1. set a to ar().}set s to c[a]. if s="PREV PAGE"{set f to f-1.}else if s="NEXT PAGE"{set f to f+1.}else{break.}}set z to "". set c to list(). if s="PREV MENU"{return-1.}return p:indexof(s).}function bh{local bi is c:length(). print z:padright(as-3)at(2,2). local h is 0. until h=bi{print h+") "+c[h]at(2,h+4). set h to h+1.}}function ar{local i to queue(). local y is 0. local e to "". local t to "". until false{if terminal:input:haschar(){local j to terminal:input:getchar(). if j=terminal:input:backspace{if i:length>0{set y to 0. set e to "". until y=i:length-1{set t to i:pop. set e to e+t. i:push(t). set y to y+1.}i:pop. print e+" " at(4,k-3).}}else if j=terminal:input:return{if e="" {print "fail" at(30,30).}else{break.}}else if unchar(j)>=48 and unchar(j)<=57{i:push(j). set e to e+j. print e at(4,k-3).}}wait 0.1.}set t to "". print t:padright(ag-6)at(4,k-3). return e:toscalar.}}
