{local f to terminal:height. local ah to terminal:width. local ar to ah/2. local z to "". local c to list(). global ui is lexicon("run",as@,"msg add",au@,"abort stop",av@,"AG6 stop",aw@). function as{parameter ax to false. if ax{local d to aa(). local ai to ay(). local w to ai[0]. local i to ai[1]. until false{if ag7{ag7 off. if d:length>0{runpath(bootvolume+":/missions/"+d[0]).}}if ag8{ag8 off. if d:length>1{runpath(bootvolume+":/missions/"+d[1]).}}if ag9{ag9 off. if d:length>2{runpath(bootvolume+":/missions/"+d[2]).}}}}else{until false{local a to "". local g to list("Missions","Maneuvers","Vessel","Reboot"). if utl["has file"](ship:name+".json",1){g:insert(g:length-1,"Delete Persist File").}clearscreen. set a to ab("Choose a function:",g). if g[a]="Missions"{az().}else if g[a]="Maneuvers"{aj(mnv).}else if g[a]="Vessel"{aj(ves1).}else if g[a]="Reboot"{reboot.}else if g[a]="Delete Persist File"{utl["delete file"](ship:name+".json",1).}}}}function ay{local ba to list("Run","Show Status","Stop","Reboot"). local w to lexicon(). local i to lexicon(). local ak to-1. local al to-1. local am to-1. local bb to-1. local ac to 0. local b to 0. local ad to aa(). for v in ba{w:add(ac,v). set ac to ac+1.}set ak to b. for m in ad{i:add(b,m). set b to b+1.}set al to b. for m in mnv:keys{i:add(b,m). set b to b+1.}set am to b. for m in ves1:keys{i:add(b,m). set b to b+1.}utl["write commands"](w,i,ak,al,am,bb). return list(w,i).}function aa{if homeconnection:isconnected utl["refresh mission files"](). local ad to utl["list file contains"]("mission",bootvolume,"missions"). return ad.}function az{until false{local ae is"None". clearscreen. local d is aa(). local af is list(). for bc in d{local an to bc:split("mission_"). af:add(an[an:length-1]:split(".ks")[0]:replace("_"," "):toupper).}af:add("Prev Menu"). set ae to ab("Select a "+core:element:name+" mission file:",af). clearscreen. if ae=-1{return false.}else{runpath(bootvolume+":/missions/"+d[ae]).}}}function aj{parameter ag. until false{local n to ag:keys. n:add("Prev Menu"). local a to "". set a to ab("Select an operation:",n). clearscreen. if a=-1{return false.}else{if n[a]:contains("&"){print"OUTPUT: "+ag[n[a]]()at(2,f-2). wait 2. return false.}else ag[n[a]]().}}}function aw{if ag6{ag6 off. return true.}else return false.}function av{if abort{return true.}else return false.}function au{parameter bd. local ao is be()+" "+bd. print(ao). if logmsgs{utl["write log"](ao).}}function be{local o is time+missiontime-time:seconds. return"T+"+p(o:year-1)+"-"+p(o:day-1,3)+" "+p(o:hour)+":"+p(o:minute)+":"+p(round(o:second)).}function p{parameter bf,bg is 2. return bf:tostring:padleft(bg):replace(" ","0").}function ab{parameter bh,s. local h to 0. local t to "". if s:empty{print"error: list_of_names should not be empty". print 1/0.}set z to bh. local ap is s:length(). local x is f/3. until false{if ap>x{set c to s:sublist(h*x,x). if h<>0{c:insert(0,"PREV PAGE").}if(h+1)*x<ap{c:add("NEXT PAGE").}}else{set c to s.}local bi to c:length(). clearscreen. bj(). local a is aq(). until a<bi{print"ERROR: INPUT OUT OF RANGE" at(9,f-3). wait 1. set a to aq().}set t to c[a]. if t="PREV PAGE"{set h to h-1.}else if t="NEXT PAGE"{set h to h+1.}else{break.}}set z to "". set c to list(). if t="PREV MENU"{return-1.}return s:indexof(t).}function bj{local bk is c:length(). print z:padright(ar-3)at(2,2). local j is 0. until j=bk{print j+") "+c[j]at(2,j+4). set j to j+1.}}function aq{local k to queue(). local y is 0. local e to "". local u to "". print"INPUT: " at(2,f-3). until false{if terminal:input:haschar(){local l to terminal:input:getchar(). if l=terminal:input:backspace{if k:length>0{set y to 0. set e to "". until y=k:length-1{set u to k:pop. set e to e+u. k:push(u). set y to y+1.}k:pop. print e+" " at(9,f-3).}}else if l=terminal:input:return{if e="" print "fail" at(9,f-3). else break.}else if unchar(l)>=48 and unchar(l)<=57{k:push(l). set e to e+l. print e at(9,f-3).}}wait 0.1.}set u to "". print u:padright(ah-9)at(9,f-3). return e:toscalar.}}
