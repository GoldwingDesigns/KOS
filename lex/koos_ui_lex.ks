local k to terminal:height. local af to terminal:width. local ar to af/2. local y to "". local c to list().{global ui is lexicon("run",as@,"msg add",au@,"AG6 stop",av@). function as{parameter aw to false. if aw{local d to z(). local ag to ax(). local u to ag[0]. local g to ag[1]. until false{if ag7{ag7 off. if d:length>0{runpath(bootvolume+":/missions/"+d[0]).}}if ag8{ag8 off. if d:length>1{runpath(bootvolume+":/missions/"+d[1]).}}if ag9{ag9 off. if d:length>2{runpath(bootvolume+":/missions/"+d[2]).}}}}else{until false{local a to "". local l to list("Missions","Maneuvers","Vessel","Reboot"). clearscreen. set a to aa("Choose a function:",l). if l[a]="Missions"{ay().}else if l[a]="Maneuvers"{ah(mnv).}else if l[a]="Vessel"{ah(ves1).}else if l[a]="Reboot"{reboot.}}}}function ax{local az to list("Run","Show Status","Stop","Reboot"). local u to lexicon(). local g to lexicon(). local ai to-1. local aj to-1. local ak to-1. local ba to-1. local ab to 0. local b to 0. local ac to z(). for v in az{u:add(ab,v). set ab to ab+1.}set ai to b. for m in ac{g:add(b,m). set b to b+1.}set aj to b. for m in mnv:keys{g:add(b,m). set b to b+1.}set ak to b. for m in ves1:keys{g:add(b,m). set b to b+1.}utl["write commands"](u,g,ai,aj,ak,ba). return list(u,g).}function z{if homeconnection:isconnected utl["refresh mission files"](). local ac to utl["list file contains"]("mission",bootvolume,"missions"). return ac.}function ay{until false{local ad is"None". clearscreen. local d is z(). local ae is list(). for bb in d{local al to bb:split("mission_"). ae:add(al[al:length-1]:split(".ks")[0]:replace("_"," "):toupper).}ae:add("Prev Menu"). set ad to aa("Select a "+core:element:name+" mission file:",ae). clearscreen. if ad=-1{return false.}else{runpath(bootvolume+":/missions/"+d[ad]).}}}function ah{parameter am. until false{local an to am:keys. an:add("Prev Menu"). local a to "". set a to aa("Select an operation:",an). clearscreen. if a="Prev Menu"{return false.}else{am[a]().}}}function av{if ag6{ag6 off. bk["stop"]().}}function au{parameter bc. local ao is bd()+" "+bc. print(ao). if logmsgs{utl["write log"](ao).}}function bd{local n is time+missiontime-time:seconds. return"T+"+o(n:year-1)+"-"+o(n:day-1,3)+" "+o(n:hour)+":"+o(n:minute)+":"+o(round(n:second)).}function o{parameter be,bf is 2. return be:tostring:padleft(bf):replace(" ","0").}function aa{parameter bg,p. local f to 0. local s to "". if p:empty{print"error: list_of_names should not be empty". print 1/0.}set y to bg. local ap is p:length(). local w is k/3. until false{if ap>w{set c to p:sublist(f*w,w). if f<>0{c:insert(0,"PREV PAGE").}if(f+1)*w<ap{c:add("NEXT PAGE").}}else{set c to p.}local bh to c:length(). clearscreen. bi(). local a is aq(). until a<bh{print"ERROR: INPUT OUT OF RANGE" at(4,k-3). wait 1. set a to aq().}set s to c[a]. if s="PREV PAGE"{set f to f-1.}else if s="NEXT PAGE"{set f to f+1.}else{break.}}set y to "". set c to list(). if s="PREV MENU"{return-1.}return p:indexof(s).}function bi{local bj is c:length(). print y:padright(ar-3)at(2,2). local h is 0. until h=bj{print h+") "+c[h]at(2,h+4). set h to h+1.}}function aq{local i to queue(). local x is 0. local e to "". local t to "". until false{if terminal:input:haschar(){local j to terminal:input:getchar(). if j=terminal:input:backspace{if i:length>0{set x to 0. set e to "". until x=i:length-1{set t to i:pop. set e to e+t. i:push(t). set x to x+1.}i:pop. print e+" " at(4,k-3).}}else if j=terminal:input:return{if e="" {print "fail" at(30,30).}else{break.}}else if unchar(j)>=48 and unchar(j)<=57{i:push(j). set e to e+j. print e at(4,k-3).}}wait 0.1.}set t to "". print t:padright(af-6)at(4,k-3). return e:toscalar.}}
