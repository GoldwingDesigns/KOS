{global mnv_tmp is lexicon("capture",h@,"planet trans",i@,"node refine",j@). function i{parameter b,f,g to 5000. ui["msg add"]("Finding Transfer to "+b:name). local a to node(0,0,0,0). local k to addons:astrogator:calculateburns(b). local x to 0. for c in k{set a to node(c:attime,c:radial,c:normal,c:prograde). add a.}ui["msg add"]("Planet Transfer Node(s) To "+b:name+" Added"). return true.}function j{parameter b,f,g to 5000. ui["msg add"]("Refining Transfer Node to "+b:name). if not hasnode{ui["msg add"]("No Node To Refine").}else{local a to nextnode. remove nextnode. set a to hillclimb(a,b,list("periapsis",f),g). add a. ui["msg add"]("Planet Transfer Node To "+b:name+" Refined").}return true.}function h{parameter l is ship:orbit:periapsis. local m to time:seconds. local n to eta:periapsis. local d to body:mu. local e to body:radius. local o to sqrt(-1*(d/ship:obt:semimajoraxis)). local p to sqrt(2*d/(e+ship:obt:periapsis)). local s to sqrt(p^2+o^2). local t to(ship:obt:periapsis+(e*2)+l)/2. local u to sqrt(d*((2/(ship:obt:periapsis+e))-(1/t))). local w to u-s. local a to node(m+n,0,0,w). add a. ui["msg add"]("Orbit Capture Node Added"). return true.}}
