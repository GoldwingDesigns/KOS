local b to constant.{global mnv_tmp is lexicon("capture",p@,"planet trans",s@). function s{parameter e,t. ui["msg add"]("Finding Transfer to "+a:name). local k to ship:orbit:body:body:mu. local l to body:orbit:semimajoraxis. local c to e:orbit:semimajoraxis. local m is e:obt:period. local u is e:obt:semimajoraxis. local w is c. local x is m*(w/u)^1.5. local y is mod(((x*0.5)/m)*360,360). local z is 180-y. local n to ship:orbit:position-body:position. local o to a:orbit:position-a:body:position. local f to vang(o,n). local aa to vcrs(o,n). if vdot(v(1,1,1),aa)<=0{set f to-1*f.}local ab is 2*b:radtodeg*b:pi/a:orbit:period. local ac is 2*b:radtodeg*b:pi/ship:orbit:period. local d is f-z. if d<0 set d to d+360. local ad to time:seconds+(d)/abs(ab-ac). local ae to sqrt(k/l). local af to sqrt(k*(2/l-1/c)). local g to af-ae. local h to node(ad,0,0,g). local ag is hillclimb(h,a,list("periapsis",t),500). add ag. ui["msg add"]("Moon Transfer Node To "+a:name+" Added"). return true.}function p{parameter ah is ship:orbit:periapsis. local ai to time:seconds. local aj to eta:periapsis. local i to body:mu. local j to body:radius. local ak to sqrt(-1*(i/ship:obt:semimajoraxis)). local al to sqrt(2*i/(j+ship:obt:periapsis)). local am to sqrt(al^2+ak^2). local c to(ship:obt:periapsis+(j*2)+ah)/2. local an to sqrt(i*((2/(ship:obt:periapsis+j))-(1/c))). local g to an-am. local h to node(ai+aj,0,0,g). add h. ui["msg add"]("Orbit Capture Node Added"). return true.}}
