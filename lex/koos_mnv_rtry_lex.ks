local a to lookdirup@.{global mnv_tmp is lexicon("aero land",e@). function e{parameter d to ves1["&lastchute"]@. local b to a(-1*velocity:orbit,-1*body:position). lock steering to b. local c to 0. ves1["sas off"](). ui["msg add"]("Commence Aero Land Program."). return list({return altitude<200000.},{set b to a(vcrs(body:position,velocity:orbit),-1*body:position). return abs(vdot(vcrs(body:position,velocity:orbit):normalized,facing:vector:normalized))>0.98.},{wait 1. if stage:ready and stage:number>d{ves1["stage"](). return false.}else{if stage:number>d{return false.}else{return true.}}},{ves1["rcs on"](). return true.},{set ship:control:fore to 1. set c to time:seconds. return true.},{return c+3<time:seconds.},{set ship:control:neutralize to true. set c to time:seconds. return true.},{return c+10<time:seconds.},{ves1["rcs off"](). return true.},{set b to a(-1*velocity:surface,-1*body:position). return true.},{ves1["comms ret"](). return true.},{set b to a(-1*velocity:surface,-1*body:position). return alt:radar<20000 and airspeed<280.},{unlock steering. return true.},{ves1["arm chutes"](). return true.},{return ship:status="SPLASHED" or ship:status="LANDED".},{if addons:available("scansat"){if ship:status="SPLASHED"{ui["msg add"](ship:name+" splashed down on "+body:name+". L/L: "+geoposition:lat+", "+geoposition:lng+" Biome: "+addons:scansat:currentbiome).}if ship:status="LANDED"{ui["msg add"](ship:name+" landed on "+body:name+". L/L: "+geoposition:lat+", "+geoposition:lng+" Biome: "+addons:scansat:currentbiome).}}else{if ship:status="SPLASHED"{ui["msg add"](ship:name+" splashed down on "+body:name+". L/L: "+geoposition:lat+", "+geoposition:lng).}if ship:status="LANDED"{ui["msg add"](ship:name+" landed on "+body:name+". L/L: "+geoposition:lat+", "+geoposition:lng).}}return true.}).}}
