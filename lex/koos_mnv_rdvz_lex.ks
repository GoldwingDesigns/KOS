local d to constant.{global mnv_tmp is lexicon("cancel vel cpa",t@,"ship transfer",u@). function t{parameter a. local f is ao(a,node(0,0,0,0),true,10). add node(f,0,0,0). local w is velocityat(ship,f):orbit. local x is velocityat(a,f):orbit. local y is(w-x). local z is find_burntime(abs(y:mag)). local n is f-z. local j to 0. local k to 0. lock throttle to j. return list({warpto(n-30). return true.},{if not a:istype("Vessel"){set a to a:ship.}lock g to velocity:orbit-a:velocity:orbit. sas off. lock steering to-g. return true.},{return vcrs(facing:forevector,g):mag<0.1.},{return time:seconds>n-1.},{set k to g:mag. set j to min(1,k/20). return k<0.1.},{set j to 0. unlock g. unlock throttle. unlock steering. sas on. if hasnode remove nextnode. wait 1. return true.}).}function u{parameter a,aa is 500. set target to a. local l to ship:orbit:body:mu. local c to ship:orbit:semimajoraxis. local h to a:orbit:semimajoraxis. local i is(c+h)/2. local e is 1-(c/i). local m is 0. set m to arccos(round(((((i*(1-e^2))/h)-1)/e),6)). local o is arccos((e+cos(m))/(1+(e*cos(m)))). local ab is((o*d:degtorad-e*sin(o))*sqrt((i^3)/l)). local ac is(ab/ap(body,a:orbit:periapsis,a:orbit:apoapsis))*360. local ad is 180-ac. local p to ship:orbit:position-body:position. local s to a:orbit:position-a:body:position. local b to vang(s,p). local ae to vcrs(s,p). if vdot(v(1,1,1),ae)<=0{set b to-1*b.}local af is 2*d:radtodeg*d:pi/a:orbit:period. local ag is 2*d:radtodeg*d:pi/ship:orbit:period. if h>c and b<0 set b to b+360. if c>h and b>0 set b to b-360. local ah is abs(b-ad). local ai to time:seconds+(ah)/abs(af-ag). local aj to sqrt(l/c). local ak to sqrt(l*(2/c-1/i)). local al to ak-aj. local am to node(ai,0,0,al). local an is hillclimb(am,a,list("shiptoship",aa),20). add an. return true.}}
