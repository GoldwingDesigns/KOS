{global mnv_tmp is lexicon("match inc lan",k@,"change per",l@,"change arg per",m@). function k{parameter j. return mnv["change inc lan"]@:bind(j:obt:inclination,j:obt:lan).}function l{parameter d. local b to body:mu. local a to body:radius+apoapsis. local e to body:radius+((apoapsis+periapsis)/2). local f to body:radius+((apoapsis+d)/2). local g to sqrt(b*(2/a-1/f))-sqrt(b*(2/a-1/e)). local h to node(time:seconds+eta:apoapsis,0,0,g). add h. ui["msg add"]("Change Pe Node Added."). return true.}function m{parameter n,d. local b to body:mu. local a to ship:orbit:semimajoraxis. local e to ship:orbit:semimajoraxis. local f to(body:radius+ship:orbit:semimajoraxis+d)/2. local g to sqrt(b*(2/a-1/f))-sqrt(b*(2/a-1/e)). local c to n-ship:orbit:argumentofperiapsis. if c<0 set c to c+360. local i is 0. if a>=d+body:radius{set i to find_eta_to_true_anomaly(mod(c+180,360)).}else{set i to find_eta_to_true_anomaly(mod(c,360)).}local h to node(time:seconds+i,0,0,g). add h. ui["msg add"]("Change Pe Node Added."). return true.}}
