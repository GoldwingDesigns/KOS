local c to heading@.{global mnv_tmp is lexicon("moon return",s@,"launch no atmo",t@). function t{parameter a,u to geoposition:lat. local e to 0. local d to 1. local b to c(90,90). local f to a. local w to 0.1. local g to 0. local h to 90. local i to lazcalc(lazcalc_init(a,u)). ves1["sas off"](). lock throttle to d. lock steering to b. if starttime=0 set starttime to time. return list({set b to c(90,90). man_check_stage(0). return velocity:surface:mag>50.},{ves1["gear up"](). set g to altitude-10. ui["msg add"]("Commence Pitchover."). return true.},{set h to 90*(1-((altitude-g)/f)^w). set b to c(i,h). set d to 1. man_check_stage(0). return altitude>f or apoapsis>a.},{set b to c(i,0). if apoapsis<a{set d to 1.}else{set d to 0.}man_check_stage(0). return apoapsis>=a and altitude>=ship:orbit:body:atm:height.},{lock throttle to 0. wait 1. unlock throttle. set b to lookdirup(prograde:forevector,body:position). set e to time:seconds. return true.},{return e+10<time:seconds.},{unlock steering. ui["msg add"]("Launch Complete."). return true.}).}function s{parameter j. ui["msg add"]("Finding Transfer to "+body:obt:body:name). local k to body:mu. local l to body:obt:body:mu. local m to ship:obt:semimajoraxis. local x to body:soiradius. local y to body:obt:body:radius. local n to body:altitude+body:obt:body:radius. local o to n-x. local z to body:body:name. local aa to sqrt((2*k)/(m)). local ab to velocity:obt:mag. local ac to sqrt(l*((2/o)-(2/(o+(j+y))))). local ad to sqrt(l/n). local ae to ad-ac. local p to sqrt(ae^2+aa^2). local af to p-ab. local ag to(((m*p^2)/k)-1). local ah to arccos(-1/ag). local ai to calc_ejection_utc(ah). local aj to node(ai,0,0,af). local ak is hillclimb(aj,z,list("periapsis",j),100). add ak. ui["msg add"]("Moon Return Node Added"). return true.}}
