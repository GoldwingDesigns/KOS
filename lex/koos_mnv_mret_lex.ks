local d to constant. local e to heading@.{global mnv_tmp is lexicon("moon return",y@,"launch no atmo",z@). function z{parameter b,aa to geoposition:lat. local h to 0. local f to 1. local c to e(90,90). local i to b. local ab to 0.1. local j to 0. local k to 90. local l to lazcalc(lazcalc_init(b,aa)). ves1["sas off"](). lock throttle to f. lock steering to c. if starttime=0 set starttime to time. return list({set c to e(90,90). man_check_stage(0). return velocity:surface:mag>50.},{ves1["gear up"](). set j to altitude-10. ui["msg add"]("Commence Pitchover."). return true.},{set k to 90*(1-((altitude-j)/i)^ab). set c to e(l,k). set f to 1. man_check_stage(0). return altitude>i or apoapsis>b.},{set c to e(l,0). if apoapsis<b{set f to 1.}else{set f to 0.}man_check_stage(0). return apoapsis>=b and altitude>=ship:orbit:body:atm:height.},{lock throttle to 0. wait 1. unlock throttle. set c to lookdirup(prograde:forevector,body:position). set h to time:seconds. return true.},{return h+10<time:seconds.},{unlock steering. ui["msg add"]("Launch Complete."). return true.}).}function y{parameter m. ui["msg add"]("Finding Transfer to "+body:obt:body:name). local n to body:mu. local o to body:obt:body:mu. local p to ship:obt:semimajoraxis. local ac to body:soiradius. local ad to body:obt:body:radius. local s to body:altitude+body:obt:body:radius. local t to s-ac. local ae to body:body:name. local af to sqrt((2*n)/(p)). local ag to velocity:obt:mag. local ah to sqrt(o*((2/t)-(2/(t+(m+ad))))). local ai to sqrt(o/s). local aj to ai-ah. local u to sqrt(aj^2+af^2). local ak to u-ag. local al to(((p*u^2)/n)-1). local am to arccos(-1/al). local w to ship:orbit:position-body:position. local x to body:body:velocity:orbit. local a to vang(x,w). local an to vcrs(x,w). if vdot(v(1,1,1),an)<=0{set a to-1*a.}if a<0 set a to a+360. local ao is 2*d:radtodeg*d:pi/body:orbit:period. local ap is 2*d:radtodeg*d:pi/ship:orbit:period. local g is a-am. if g<0 set g to g+360. local aq to time:seconds+(g)/abs(ao-ap). local ar to node(aq,0,0,ak). local as is hillclimb(ar,ae,list("periapsis",m),100). add as. ui["msg add"]("Moon Return Node Added"). return true.}}
