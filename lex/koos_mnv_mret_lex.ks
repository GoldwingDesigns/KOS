local d to constant. local e to heading@.{global mnv_tmp is lexicon("moon return",y@,"launch no atmo",z@). function z{parameter b,aa to geoposition:lat. local h to 0. local f to 1. local c to e(90,90). local i to b. local ab to 0.1. local j to 0. local k to 90. local l to lazcalc(lazcalc_init(b,aa)). ves1["sas off"](). lock throttle to f. lock steering to c. if ac=0 set ac to time. return list({set c to e(90,90). man_check_stage(0). return velocity:surface:mag>50.},{ves1["gear up"](). set j to altitude-10. ui["msg add"]("Commence Pitchover."). return true.},{set k to 90*(1-((altitude-j)/i)^ab). set c to e(l,k). set f to 1. man_check_stage(0). return altitude>i or apoapsis>b.},{set c to e(l,0). if apoapsis<b{set f to 1.}else{set f to 0.}man_check_stage(0). return apoapsis>=b and altitude>=ship:orbit:body:atm:height.},{lock throttle to 0. wait 1. unlock throttle. set c to lookdirup(prograde:forevector,body:position). set h to time:seconds. return true.},{return h+10<time:seconds.},{unlock steering. ui["msg add"]("Launch Complete."). return true.}).}function y{parameter m. ui["msg add"]("Finding Transfer to "+body:obt:body:name). local n to body:mu. local o to body:obt:body:mu. local p to ship:obt:semimajoraxis. local ad to body:soiradius. local ae to body:obt:body:radius. local s to body:altitude+body:obt:body:radius. local t to s-ad. local af to body:body:name. local ag to sqrt((2*n)/(p)). local ah to velocity:obt:mag. local ai to sqrt(o*((2/t)-(2/(t+(m+ae))))). local aj to sqrt(o/s). local ak to aj-ai. local u to sqrt(ak^2+ag^2). local al to u-ah. local am to(((p*u^2)/n)-1). local an to arccos(-1/am). local w to ship:orbit:position-body:position. local x to body:body:velocity:orbit. local a to vang(x,w). local ao to vcrs(x,w). if vdot(v(1,1,1),ao)<=0{set a to-1*a.}if a<0 set a to a+360. local ap is 2*d:radtodeg*d:pi/body:orbit:period. local aq is 2*d:radtodeg*d:pi/ship:orbit:period. local g is a-an. if g<0 set g to g+360. local ar to time:seconds+(g)/abs(ap-aq). local as to node(ar,0,0,al). local au is hillclimb(as,af,list("periapsis",m),100). add au. ui["msg add"]("Moon Return Node Added"). return true.}}
