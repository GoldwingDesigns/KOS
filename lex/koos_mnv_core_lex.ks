local j to lookdirup@. local f to sqrt@.{global mnv_tmp is lexicon("exec node",ah@,"unlock all",ai@,"hoh trans 1",aj@,"hoh trans 2",ak@,"change inc lan alt",ab@,"change apo",p@,"change per",s@,"circ",al@,"change inc lan",am@,"orbit sun angle",an@). function ah{parameter ao to ves1["&lastengine"](). local a to nextnode. ves1["sas off"](). local ac to 0. lock throttle to ac. ves1["check ign"](). wait 3. local t to find_burntime(a:deltav:mag). local lock ad to maxthrust/mass. local ae to a:deltav:vec. lock steering to j(a:deltav,body:position). local af to 0. ui["msg add"]("Executing Node. dV: "+round(a:deltav:mag)+" Burntime: "+round(t)). return list({warpto(a:eta-(t/2)-60+time:seconds). return true.},{set ae to a:deltav:vec. return a:eta<=t/2.},{if ad<>0 set ac to min(a:deltav:mag/ad,1). man_check_stage(ao). return a:deltav:mag<0.1 or vdot(ae,a:deltav)<0.05.},{lock throttle to 0. local u to ves1["&solardir"](). if u:contains("fore"){lock steering to j(body("sun"):position,body:position).}else if u:contains("aft"){lock steering to j(-1*body("sun"):position,body:position).}else if u:contains("side"){lock steering to j(vcrs(body("sun"):position,velocity:orbit),body:position).}else{lock steering to j(body("sun"):position,body:position).}. set af to time:seconds. return true.},{return af+15<time:seconds.},{set ship:control:pilotmainthrottle to 0. mnv["unlock all"](). ves1["sas on"](). remove a. wait 0.1. ui["msg add"]("Node Execution Complete."). return true.}).}function ai{unlock steering. unlock throttle.}function aj{parameter d. if eta:apoapsis<eta:periapsis{s(d).}else{p(d).}return true.}function ak{parameter d. local ap to abs(obt:apoapsis-d). local aq to abs(obt:periapsis-d). if ap<aq{s(d).}else{p(d).}return true.}function ab{parameter g,b,o. if b:istype("UserDelegate")set b to b:call. local h to plane_change_info(g,b). local k to h[0]. local i to h[1]. local w to h[2]. local c to(positionat(ship,i)-body:position):mag. local l to(c+body:radius+o)/2. local ar is velocityat(ship,i):orbit:mag. local ag is f(body:mu*((2/c)-(1/l))). local x to ag*sin(k). local y to(ag*cos(k))-ar. local a is node(i,0,0,0). set a:normal to w*x. set a:prograde to y. add a. ui["msg add"]("Inc/LAN/Alt Node Added: "+g+"/"+b+"/"+o). return true.}function p{parameter d. local e to body:mu. local c to body:radius+periapsis. local m to body:radius+((periapsis+apoapsis)/2). local l to body:radius+((periapsis+d)/2). local n to f(e*(2/c-1/l))-f(e*(2/c-1/m)). local a to node(time:seconds+eta:periapsis,0,0,n). add a. ui["msg add"]("Change Apo Node Added."). return true.}function s{parameter d. local e to body:mu. local c to body:radius+apoapsis. local m to body:radius+((apoapsis+periapsis)/2). local l to body:radius+((apoapsis+d)/2). local n to f(e*(2/c-1/l))-f(e*(2/c-1/m)). local a to node(time:seconds+eta:apoapsis,0,0,n). add a. ui["msg add"]("Change Pe Node Added."). return true.}function al{local e to body:mu. local z to eta:apoapsis<eta:periapsis. local m to body:radius+((apoapsis+periapsis)/2). local c to choose body:radius+apoapsis if z else body:radius+periapsis. local n to f(e*(2/c-1/c))-f(e*(2/c-1/m)). local a to node(time:seconds+(choose eta:apoapsis if z else eta:periapsis),0,0,n). add a. ui["msg add"]("Circularize Node Added At "+(choose"Apoapsis" if z else"Periapsis")). return true.}function am{parameter g,b to orbit:lan. if b:istype("UserDelegate")set b to b:call. local h to plane_change_info(g,b). local k to h[0]. local i to h[1]. local w to h[2]. local aa is velocityat(ship,i):orbit:mag. local x to aa*sin(k). local y to aa*cos(k)-aa. local a is node(i,0,0,0). set a:normal to w*x. set a:prograde to y. add a. ui["msg add"]("Inc/LAN Node Added: "+g+"/"+b). return true.}function an{parameter g,o,as,au to 0. local b is getlanforsunangle(as,au). ab(g,b,o). return true.}}
