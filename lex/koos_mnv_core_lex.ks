{global mnv_tmp is lexicon("exec node",ad@,"unlock all",unlock_all@,"hoh trans 1",ae@,"hoh trans 2",af@,"change inc lan alt",ag@,"change apo",j@,"circ",ah@,"change inc lan",ai@). function ad{parameter aj to ves1["&lastengine"](). local a to nextnode. ves1["sas off"](). local x to 0. lock throttle to x. ves1["check ign"](). wait 3. local k to find_burntime(a:deltav:mag). local lock y to maxthrust/mass. local z to a:deltav:vec. lock steering to lookdirup(a:deltav,body:position). local aa to 0. ui["msg add"]("Executing Node. dV: "+round(a:deltav:mag)+" Burntime: "+round(k)). return list({warpto(a:eta-(k/2)-60+time:seconds). return true.},{set z to a:deltav:vec. return a:eta<k/2.},{if y<>0 set x to min(a:deltav:mag/y,1). man_check_stage(aj). return a:deltav:mag<0.1 or vdot(z,a:deltav)<0.05.},{lock throttle to 0. local l to ves1["&solardir"](). if l:contains("fore"){lock steering to body("sun"):position.}else if l:contains("aft"){lock steering to-1*body("sun"):position.}else if l:contains("side"){lock steering to vcrs(body("sun"):position,velocity:orbit).}else{lock steering to body("sun"):position.}. set aa to time:seconds. return true.},{return aa+15<time:seconds.},{set ship:control:pilotmainthrottle to 0. unlock_all(). ves1["sas on"](). remove a. wait 0.1. ui["msg add"]("Node Execution Complete."). return true.}).}function unlock_all{unlock steering. unlock throttle.}function ae{parameter c. if eta:apoapsis<eta:periapsis{ak(c).}else{j(c).}return true.}function af{parameter c. local al to abs(obt:apoapsis-c). local am to abs(obt:periapsis-c). if al<am{ak(c).}else{j(c).}return true.}function ag{parameter g,b,ab. if b:istype("UserDelegate")set b to b:call. local e to plane_change_info(g,b). local h to e[0]. local f to e[1]. local m to e[2]. local d to(positionat(ship,f)-body:position):mag. local n to(d+body:radius+ab)/2. local an is velocityat(ship,f):orbit:mag. local ac is sqrt(body:mu*((2/d)-(1/n))). local o to ac*sin(h). local p to(ac*cos(h))-an. local a is node(f,0,0,0). set a:normal to m*o. set a:prograde to p. add a. ui["msg add"]("Inc/LAN/Alt Node Added: "+g+"/"+b+"/"+ab). return true.}function j{parameter c. local i to body:mu. local d to body:radius+periapsis. local s to body:radius+((periapsis+apoapsis)/2). local n to body:radius+((periapsis+c)/2). local t to sqrt(i*(2/d-1/n))-sqrt(i*(2/d-1/s)). local a to node(time:seconds+eta:periapsis,0,0,t). add a. ui["msg add"]("Change Apo Node Added."). return true.}function ah{local i to body:mu. local u to eta:apoapsis<eta:periapsis. local s to body:radius+((apoapsis+periapsis)/2). local d to choose body:radius+apoapsis if u else body:radius+periapsis. local t to sqrt(i*(2/d-1/d))-sqrt(i*(2/d-1/s)). local a to node(time:seconds+(choose eta:apoapsis if u else eta:periapsis),0,0,t). add a. ui["msg add"]("Circularize Node Added At "+(choose"Apoapsis" if u else"Periapsis")). return true.}function ai{parameter g,b to orbit:lan. if b:istype("UserDelegate")set b to b:call. local e to plane_change_info(g,b). local h to e[0]. local f to e[1]. local m to e[2]. local w is velocityat(ship,f):orbit:mag. local o to w*sin(h). local p to w*cos(h)-w. local a is node(f,0,0,0). set a:normal to m*o. set a:prograde to p. add a. ui["msg add"]("Inc/LAN Node Added: "+g+"/"+b). return true.}}
