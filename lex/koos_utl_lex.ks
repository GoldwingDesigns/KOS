local a to list@. local af to lexicon@. local f to path@. local j to volume@. local k to exists@. local o to chdir@. local aa to deletepath@. local ag to copypath@. local e to char@.{local bi to lex("aobt",a("koos_mnv_aobt_lex"),"core",a("koos_mnv_core_lex"),"dock",a("koos_mnv_dock_lex"),"land",a("koos_mnv_land_lex"),"lnch",a("koos_mnv_lnch_lex"),"mret",a("koos_mnv_mret_lex"),"mxfr",a("koos_mnv_mxfr_lex"),"rdvz",a("koos_mnv_rdvz_lex"),"rtry",a("koos_mnv_rtry_lex")). local ap to lex("aobt",a("koos_obtcalc_lib"),"core",a("koos_obtcalc_lib","koos_mnv_lib"),"dock",a("koos_pathfinding_lib","lib_enum"),"land",a("koos_obtcalc_lib","koos_mnv_lib"),"lnch",a("lib_LAZcalc","koos_mnv_lib"),"mret",a("koos_mnv_lib","koos_hillclimb_lib","lib_LAZcalc"),"mxfr",a("koos_hillclimb_lib"),"rdvz",a("koos_hillclimb_lib","koos_mnv_lib","koos_obtcalc_lib"),"rtry",a()). global utl is af("has file",ac@,"has file contains",bj@,"list file contains",aq@,"delete file",bk@,"delete files",bl@,"retrieve file",bm@,"retrieve file list",ar@,"refresh mission files",bn@,"refresh config files",bo@,"build MNV lex",bp@,"update lexfiles",as@,"update libfiles",au@,"update bootfiles",bq@,"write log",br@,"write commands",bs@,"read config",bt@,"reboot",bu@,"kill program",bv@). function ac{parameter c,p,g to "". local b is f(j(p)). if g<>"" set b to b:combine(g). local w to a(). local y to false. local t to f(). if k(b){o(b).}else{return false.}list files in w. for file in w{if file:name=c{set y to true. o(t). return y.}}o(t). return y.}function bj{parameter c,p,g to "". local b is f(j(p)). if g<>"" set b to b:combine(g). local w to a(). local y to false. local t to f(). if k(b){o(b).}else{return false.}list files in w. for file in w{if file:name:contains(c){set y to true. o(t). return y.}}o(t). return y.}function aq{parameter c,p,g to "". local b is f(j(p)). if g<>"" set b to b:combine(g). local aj to a(). local w to a(). local t to f(). if k(b){o(b).}else{return aj.}list files in w. for file in w{if file:name:contains(c){aj:add(file:name).}}o(t). return aj.}function bk{parameter c,p,g to "". local b is f(j(p)). if g<>"" set b to b:combine(g). if ac(c,p,g)aa(b:combine(c)). return true.}function bl{parameter p,g to"",fNameMatches to "". local b is f(j(p)). if g<>"" set b to b:combine(g). local t to f(). if k(b){o(b).}else{return false.}local av is a(). list files in av. for h in av{if h:name:contains(cl)aa(b:combine(h:name)).}o(t). return true.}function bm{parameter c,u to 0,l to"",to_volume_number to 1,to_folder to "". local s is f(j(u)). if l<>"" set s to s:combine(l). local m is f(j(ah)). if z<>"" set m to m:combine(z). if ac(c,u,l){ag(s:combine(c),m:combine(c)).}else{print(c+" not found.").}return true.}function ar{parameter bw,u to 0,l to"",to_volume_number to 1,to_folder to "",ak to true. local s is f(j(u)). if l<>"" set s to s:combine(l). local m is f(j(ah)). if z<>"" set m to m:combine(z). for c in bw{if ac(c,u,l){if ak{compile s:combine(c)to m:combine(c).}else ag(s:combine(c),m:combine(c)).}else{print(c+" not found.").}}return true.}function aw{parameter bx,u,l,ah,z,ak. local s is f(j(u)):combine(l). local m is f(j(ah)):combine(z). if k(m)and z<>"" aa(m). if k(s){ar(aq(bx,u,l),u,l,ah,z,ak).}return true.}function bn{aw("mission",0,"missions/"+core:element:name,ax,"missions",true). return true.}function bo{aw(".cfg",0,"missions/"+core:element:name,ax,"",false). return true.}function bp{parameter al to a(). local cm to a(). local ay to a(). mnv:clear(). set ad to cn:copy. set am to co:copy. if al[0]="all" set al to ap:keys(). for az in al{for ba in ap[az]{if not ad:contains(ba)ad:add(ba).}for an in bi[az]{if not am:contains(an){am:add(an). ay:add(an).}}}utl["delete files"]@:bind(ae,"lib"). utl["delete files"]@:bind(ae,"lex","mnv"). au(). as(). for h in ad{runpath(ae+":/lib/"+h).}for h in ay{runpath(ae+":/lex/"+h). local by to mnv_tmp:keys. for i in by{if not mnv:haskey(i)mnv:add(i,mnv_tmp[i]).}}mnv_tmp:clear(). return true.}function au{if homeconnection:isconnected{for h in ad{compile"0:/"+"lib/"+h to ae+":/"+"lib/"+h.}ui["msg add"]("Library Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function as{if homeconnection:isconnected{for h in am{compile"0:/"+"lex/"+h to ae+":/"+"lex/"+h.}ui["msg add"]("Lexicon Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function bq{if homeconnection:isconnected{for h in ad{compile"0:/boot/"+bz to ax+":/boot/"+bz.}ui["msg add"]("Boot Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function br{parameter ca. local d to core:element:name+"_log.txt". local n to"0:/missions/"+core:element:name+"/". log ca to d. if homeconnection:isconnected{if not k(n)createdir(n). if k(n+d)aa(n+d). ag(d,n).}}function bs{parameter bb is af(),bc is af(),cb is-1,cc is-1,ce is-1,cf is-1. local d to core:element:name+"_commands.txt". local n to"0:/missions/"+core:element:name+"/". if k(d)aa(d). local cg to bb:keys. log("VERBS"+e(10)+"--------")to d. for i in cg{log(e(9)+bd(be(i))+e(9)+bb[i])to d.}local ch to bc:keys. log("NOUNS"+e(10)+"--------")to d. for i in ch{if i=cb{log(e(9)+"Missions"+e(10)+e(9)+"-------")to d.}if i=cc{log(e(9)+"Maneuvers"+e(10)+e(9)+"-------")to d.}if i=ce{log(e(9)+"Actions"+e(10)+e(9)+"-------")to d.}if i=cf{log(e(9)+"Status"+e(10)+e(9)+"-------")to d.}log(e(9)+bd(be(i))+e(9)+bc[i])to d.}if homeconnection:isconnected{if not k(n)createdir(n). if k(n+d)aa(n+d). ag(d,n).}}function bd{parameter ci. local x to"00"+ci:tostring. return x:substring(x:length-2,2).}function be{parameter ai. local ao is "". until(ai=0){set ao to mod(ai,8):tostring+ao. set ai to floor(ai/8).}return ao.}function bt{parameter bf to"ship.cfg". if ac(bf,1){local ab is af(). set ab to cj("1:/"+bf). return ab.}else return lex().}function cj{parameter d. local ab to lex(). local bg to "". local ck to open(d):readall. local bh to ck:iterator. until not bh:next{local bg to bh:value. local x to bg:split(":"). if x[1]:tonumber(-999999)<>-999999 ab:add(x[0],x[1]:tonumber). else ab:add(x[0],x[1]).}return ab.}function bu{reboot.}function bv{ui["msg add"]("Program Killed at User Request."). print 1/0.}}
