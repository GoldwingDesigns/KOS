local a to list@. local af to lexicon@. local f to path@. local j to volume@. local k to exists@. local o to chdir@. local aa to deletepath@. local ab to copypath@. local e to char@.{local bd to lex("aobt",a("koos_mnv_aobt_lex"),"core",a("koos_mnv_core_lex"),"dock",a("koos_mnv_dock_lex"),"land",a("koos_mnv_land_lex"),"lnch",a("koos_mnv_lnch_lex"),"mret",a("koos_mnv_mret_lex"),"mxfr",a("koos_mnv_mxfr_lex"),"pxfr",a("koos_mnv_pxfr_lex"),"rdvz",a("koos_mnv_rdvz_lex"),"rtry",a("koos_mnv_rtry_lex")). local am to lex("aobt",a("koos_obtcalc_lib"),"core",a("koos_obtcalc_lib","koos_mnv_lib"),"dock",a("koos_pathfinding_lib","lib_enum"),"land",a("koos_obtcalc_lib","koos_mnv_lib"),"lnch",a("lib_LAZcalc","koos_mnv_lib"),"mret",a("koos_mnv_lib","koos_hillclimb_lib","lib_LAZcalc"),"mxfr",a("koos_hillclimb_lib"),"pxfr",a("koos_hillclimb_lib"),"rdvz",a("koos_hillclimb_lib","koos_mnv_lib","koos_obtcalc_lib"),"rtry",a()). global utl is af("has file",ae@,"has file contains",be@,"list file contains",an@,"delete file",bf@,"delete files",bg@,"retrieve file",bh@,"retrieve file list",ao@,"refresh mission files",bi@,"refresh config files",bj@,"build MNV lex",bk@,"update lexfiles",ap@,"update libfiles",aq@,"update bootfiles",bl@,"write log",bm@,"write commands",bn@,"read config",bo@,"reboot",bp@,"kill program",bq@). function ae{parameter d,p,g to" ". local b is f(j(p)). if g<>" " set b to b:combine(g). local x to a(). local z to false. local t to f(). if k(b){o(b).}else{return false.}list files in x. for file in x{if file:name=d{set z to true. o(t). return z.}}o(t). return z.}function be{parameter d,p,g to" ". local b is f(j(p)). if g<>" " set b to b:combine(g). local x to a(). local z to false. local t to f(). if k(b){o(b).}else{return false.}list files in x. for file in x{if file:name:contains(d){set z to true. o(t). return z.}}o(t). return z.}function an{parameter d,p,g to" ". local b is f(j(p)). if g<>" " set b to b:combine(g). local ah to a(). local x to a(). local t to f(). if k(b){o(b).}else{return ah.}list files in x. for file in x{if file:name:contains(d){ah:add(file:name).}}o(t). return ah.}function bf{parameter d,p,g to" ". local b is f(j(p)). if g<>" " set b to b:combine(g). if ae(d,p,g)aa(b:combine(d)). return true.}function bg{parameter p,g to" ",br to "". local b is f(j(p)). if g<>" " set b to b:combine(g). local t to f(). if k(b){o(b).}else{return false.}local ar is a(). list files in ar. for h in ar{if h:name:contains(br)aa(b:combine(h:name)).}o(t). return true.}function bh{parameter d,u to 0,l to" ",ac to 1,w to" ". local s is f(j(u)). if l<>" " set s to s:combine(l). local m is f(j(ac)). if w<>" " set m to m:combine(w). if ae(d,u,l){ab(s:combine(d),m:combine(d)).}else{print(d+" not found.").}return true.}function ao{parameter bs,u,l,ac,w,ai to true. local s is f(j(u)). if l<>"" set s to s:combine(l). local m is f(j(ac)). if w<>"" set m to m:combine(w). for d in bs{if ae(d,u,l){if ai{compile s:combine(d)to m:combine(d).}else ab(s:combine(d),m:combine(d)).}else{print(d+" not found.").}}return true.}function as{parameter bt,u,l,ac,w,ai. local s is f(j(u)):combine(l). local m is f(j(ac)):combine(w). if k(m)and w<>"" aa(m). if k(s){ao(an(bt,u,l),u,l,ac,w,ai).}return true.}function bi{as("mission",0,"missions/"+core:element:name,bootvolume,"missions",true). return true.}function bj{as(".cfg",0,"missions/"+core:element:name,bootvolume,"",false). return true.}function bk{parameter aj to a(). local ci to a(). local au to a(). mnv:clear(). set libfiles to bootlibfiles:copy. set lexfiles to bootlexfiles:copy. if aj[0]="all" set aj to am:keys(). for av in aj{for aw in am[av]{if not libfiles:contains(aw)libfiles:add(aw).}for ak in bd[av]{if not lexfiles:contains(ak){lexfiles:add(ak). au:add(ak).}}}utl["delete files"](bootvolume,"lib"). utl["delete files"](datavolume,"lex","mnv"). aq(). ap(). for h in libfiles{runpath(bootvolume+":/lib/"+h).}for h in au{runpath(datavolume+":/lex/"+h). local bu to mnv_tmp:keys. for i in bu{if not mnv:haskey(i)mnv:add(i,mnv_tmp[i]).}}mnv_tmp:clear(). return true.}function aq{if homeconnection:isconnected{for h in libfiles{ab("0:/lib/"+h+".ks",bootvolume+":/lib/"+h+".ks").}ui["msg add"]("Library Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function ap{if homeconnection:isconnected{for h in lexfiles{ab("0:/lex/"+h+".ks",datavolume+":/lex/"+h+".ks").}ui["msg add"]("Lexicon Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function bl{if homeconnection:isconnected{for h in libfiles{ab("0:/boot/"+bv+".ks",bootvolume+":/boot/"+bv+".ks").}ui["msg add"]("Boot Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function bm{parameter bw. local c to core:element:name+"_log.txt". local n to"0:/missions/"+core:element:name+"/". log bw to c. if homeconnection:isconnected{if not k(n)createdir(n). if not k(n+c)create(n+c). open(f(n+c)):write(open(c):readall). aa(c).}}function bn{parameter ax is af(),ay is af(),bx is-1,by is-1,bz is-1,ca is-1. local c to core:element:name+"_commands.txt". local n to"0:/missions/"+core:element:name+"/". if k(c)aa(c). local cb to ax:keys. log("VERBS"+e(10)+"--------")to c. for i in cb{log(e(9)+az(ba(i))+e(9)+ax[i])to c.}local cc to ay:keys. log("NOUNS"+e(10)+"--------")to c. for i in cc{if i=bx{log(e(9)+"Missions"+e(10)+e(9)+"-------")to c.}if i=by{log(e(9)+"Maneuvers"+e(10)+e(9)+"-------")to c.}if i=bz{log(e(9)+"Actions"+e(10)+e(9)+"-------")to c.}if i=ca{log(e(9)+"Status"+e(10)+e(9)+"-------")to c.}log(e(9)+az(ba(i))+e(9)+ay[i])to c.}if homeconnection:isconnected{if not k(n)createdir(n). if k(n+c)aa(n+c). ab(c,n).}}function az{parameter ce. local y to"00"+ce:tostring. return y:substring(y:length-2,2).}function ba{parameter ag. local al is "". until(ag=0){set al to mod(ag,8):tostring+al. set ag to floor(ag/8).}return al.}function bo{parameter bb to"ship.cfg". if ae(bb,1){local ad is af(). set ad to cf("1:/"+bb). return ad.}else return lex().}function cf{parameter c. local ad to lex(). local cg to open(c):readall. local bc to cg:iterator. until not bc:next{local ch to bc:value. local y to ch:split(":"). if y[1]:tonumber(-999999)<>-999999 ad:add(y[0],y[1]:tonumber). else ad:add(y[0],y[1]).}return ad.}function bp{reboot.}function bq{ui["msg add"]("Program Killed at User Request."). print 1/0.}}
