local a to list@. local af to lexicon@. local f to path@. local j to volume@. local m to exists@. local n to chdir@. local aa to deletepath@. local ab to copypath@. local e to char@.{local bd to lex("aobt",a("koos_mnv_aobt_lex"),"core",a("koos_mnv_core_lex"),"dock",a("koos_mnv_dock_lex"),"land",a("koos_mnv_land_lex"),"lnch",a("koos_mnv_lnch_lex"),"mret",a("koos_mnv_mret_lex"),"mxfr",a("koos_mnv_mxfr_lex"),"rdvz",a("koos_mnv_rdvz_lex"),"rtry",a("koos_mnv_rtry_lex")). local am to lex("aobt",a("koos_obtcalc_lib"),"core",a("koos_obtcalc_lib","koos_mnv_lib"),"dock",a("koos_pathfinding_lib","lib_enum"),"land",a("koos_obtcalc_lib","koos_mnv_lib"),"lnch",a("lib_LAZcalc","koos_mnv_lib"),"mret",a("koos_mnv_lib","koos_hillclimb_lib","lib_LAZcalc"),"mxfr",a("koos_hillclimb_lib"),"rdvz",a("koos_hillclimb_lib","koos_mnv_lib","koos_obtcalc_lib"),"rtry",a()). global utl is af("has file",ae@,"has file contains",be@,"list file contains",an@,"delete file",bf@,"delete files",bg@,"retrieve file",bh@,"retrieve file list",ao@,"refresh mission files",bi@,"refresh config files",bj@,"build MNV lex",bk@,"update lexfiles",ap@,"update libfiles",aq@,"update bootfiles",bl@,"write log",bm@,"write commands",bn@,"read config",bo@,"reboot",bp@,"kill program",bq@). function ae{parameter c,o,g to" ". local b is f(j(o)). if g<>" " set b to b:combine(g). local x to a(). local z to false. local s to f(). if m(b){n(b).}else{return false.}list files in x. for file in x{if file:name=c{set z to true. n(s). return z.}}n(s). return z.}function be{parameter c,o,g to" ". local b is f(j(o)). if g<>" " set b to b:combine(g). local x to a(). local z to false. local s to f(). if m(b){n(b).}else{return false.}list files in x. for file in x{if file:name:contains(c){set z to true. n(s). return z.}}n(s). return z.}function an{parameter c,o,g to" ". local b is f(j(o)). if g<>" " set b to b:combine(g). local ah to a(). local x to a(). local s to f(). if m(b){n(b).}else{return ah.}list files in x. for file in x{if file:name:contains(c){ah:add(file:name).}}n(s). return ah.}function bf{parameter c,o,g to" ". local b is f(j(o)). if g<>" " set b to b:combine(g). if ae(c,o,g)aa(b:combine(c)). return true.}function bg{parameter o,g to" ",br to "". local b is f(j(o)). if g<>" " set b to b:combine(g). local s to f(). if m(b){n(b).}else{return false.}local ar is a(). list files in ar. for h in ar{if h:name:contains(br)aa(b:combine(h:name)).}n(s). return true.}function bh{parameter c,t to 0,k to" ",ac to 1,u to" ". local p is f(j(t)). if k<>" " set p to p:combine(k). local l is f(j(ac)). if u<>" " set l to l:combine(u). if ae(c,t,k){ab(p:combine(c),l:combine(c)).}else{print(c+" not found.").}return true.}function ao{parameter bs,t,k,ac,u,ai to true. local p is f(j(t)). if k<>"" set p to p:combine(k). local l is f(j(ac)). if u<>"" set l to l:combine(u). for c in bs{if ae(c,t,k){if ai{compile p:combine(c)to l:combine(c).}else ab(p:combine(c),l:combine(c)).}else{print(c+" not found.").}}return true.}function as{parameter bt,t,k,ac,u,ai. local p is f(j(t)):combine(k). local l is f(j(ac)):combine(u). if m(l)and u<>"" aa(l). if m(p){ao(an(bt,t,k),t,k,ac,u,ai).}return true.}function bi{as("mission",0,"missions/"+core:element:name,bootvolume,"missions",false). return true.}function bj{as(".cfg",0,"missions/"+core:element:name,bootvolume,"",false). return true.}function bk{parameter aj to a(). local ci to a(). local au to a(). mnv:clear(). set libfiles to bootlibfiles:copy. set lexfiles to bootlexfiles:copy. if aj[0]="all" set aj to am:keys(). for av in aj{for aw in am[av]{if not libfiles:contains(aw)libfiles:add(aw).}for ak in bd[av]{if not lexfiles:contains(ak){lexfiles:add(ak). au:add(ak).}}}utl["delete files"](datavolume,"lib"). utl["delete files"](datavolume,"lex","mnv"). aq(). ap(). for h in libfiles{runpath(datavolume+":/lib/"+h).}for h in au{runpath(datavolume+":/lex/"+h). local bu to mnv_tmp:keys. for i in bu{if not mnv:haskey(i)mnv:add(i,mnv_tmp[i]).}}mnv_tmp:clear(). return true.}function aq{if homeconnection:isconnected{for h in libfiles{ab("0:/lib/"+h+".ks",datavolume+":/lib/"+h+".ks").}ui["msg add"]("Library Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function ap{if homeconnection:isconnected{for h in lexfiles{ab("0:/lex/"+h+".ks",datavolume+":/lex/"+h+".ks").}ui["msg add"]("Lexicon Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function bl{if homeconnection:isconnected{for h in libfiles{ab("0:/boot/"+bv+".ks",bootvolume+":/boot/"+bv+".ks").}ui["msg add"]("Boot Files Updated.").}else{ui["msg add"]("Ship not connected to Kerbin.").}return true.}function bm{parameter bw. local d to core:element:name+"_log.txt". local w to"0:/missions/"+core:element:name+"/". log bw to d. if homeconnection:isconnected{if not m(w)createdir(w). open(f(w+d)):write(open(d):readall). aa(d).}}function bn{parameter ax is af(),ay is af(),bx is-1,by is-1,bz is-1,ca is-1. local d to core:element:name+"_commands.txt". local w to"0:/missions/"+core:element:name+"/". if m(d)aa(d). local cb to ax:keys. log("VERBS"+e(10)+"--------")to d. for i in cb{log(e(9)+az(ba(i))+e(9)+ax[i])to d.}local cc to ay:keys. log("NOUNS"+e(10)+"--------")to d. for i in cc{if i=bx{log(e(9)+"Missions"+e(10)+e(9)+"-------")to d.}if i=by{log(e(9)+"Maneuvers"+e(10)+e(9)+"-------")to d.}if i=bz{log(e(9)+"Actions"+e(10)+e(9)+"-------")to d.}if i=ca{log(e(9)+"Status"+e(10)+e(9)+"-------")to d.}log(e(9)+az(ba(i))+e(9)+ay[i])to d.}if homeconnection:isconnected{if not m(w)createdir(w). if m(w+d)aa(w+d). ab(d,w).}}function az{parameter ce. local y to"00"+ce:tostring. return y:substring(y:length-2,2).}function ba{parameter ag. local al is "". until(ag=0){set al to mod(ag,8):tostring+al. set ag to floor(ag/8).}return al.}function bo{parameter bb to"ship.cfg". if ae(bb,1){local ad is af(). set ad to cf("1:/"+bb). return ad.}else return lex().}function cf{parameter d. local ad to lex(). local cg to open(d):readall. local bc to cg:iterator. until not bc:next{local ch to bc:value. local y to ch:split(":"). if y[1]:tonumber(-999999)<>-999999 ad:add(y[0],y[1]:tonumber). else ad:add(y[0],y[1]).}return ad.}function bp{reboot.}function bq{ui["msg add"]("Program Killed at User Request."). print 1/0.}}
