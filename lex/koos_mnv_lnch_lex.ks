local e to heading@.{global mnv_tmp is lexicon("launch atmo",o@). function o{parameter a,p,s is true,t is 45,u is 4,f is-90. local m to 0. local d to 1. local b to e(90,90,f). local w to a. local n to 90. local c to 0. local g to ship:orbit:body:atm:height. local i to ves1["&launchstage"](). local j to lazcalc(lazcalc_init(a,p)). local k to choose pidloop(0.1,0.0,0.1,-0.5,0.5)if s else pidloop(0.1,0,0.01,-0.5,0.5). set k:setpoint to t. ves1["sas off"](). lock throttle to d. lock steering to b. when altitude>g-2000 then{ves1["fairing deploy"]().}when altitude>g-1000 then{ves1["comms ext"]().}when altitude>g then{ves1["panels on"]().}if starttime=0{set starttime to time. local h to time. ui["msg add"]("Commence Launch Program at "+h:year+"y "+h:day+"d "+h:hour+"h "+h:minute+"m "+h:second+"s.").}return list({set b to e(90,90,f). stage. return true.},{man_check_stage(i). return alt:radar>500.},{ves1["gear up"](). ui["msg add"]("Commence Pitchover."). return true.},{set n to 90-u. local l to eta:apoapsis . set b to e(j,n,f). set c to d+k:update(time:seconds,l)*min(1,(a-apoapsis)/1000). set d to min(1,max(c,0.05)). man_check_stage(i). return vcrs(b:vector,srfprograde:vector):mag<0.01.},{ui["msg add"]("Steering Unlocked. Gravity Turn Initiated."). return true.},{set b to e(j,90-pitchangle(srfprograde),f). local l to eta:apoapsis . set c to d+k:update(time:seconds,l)*min(1,(a-apoapsis)/1000). set d to min(1,max(c,0.05)). man_check_stage(i). return altitude>w or apoapsis>a.},{set b to e(j,0,f). if apoapsis<a and altitude>=g{set c to 1*min(1,(a-apoapsis)/1000).}else{set c to 0.}set d to min(1,max(c,0)). man_check_stage(i). return apoapsis>=a and altitude>=g.},{unlock throttle. set b to lookdirup(prograde:forevector,body:position). set m to time:seconds. return true.},{return m+10<time:seconds.},{unlock steering. ui["msg add"]("Launch Complete."). return true.}).}}
